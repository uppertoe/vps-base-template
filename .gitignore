# Ansible
*.retry
# gitignore does NOT support bash extglob — the old !(production.example)
# pattern silently ignored nothing, leaving real inventories committable.
ansible/inventory/*
!ansible/inventory/production.example

# Environment files
.env
*.env
!*.env.example
# Test fixtures contain no real credentials — always commit them
!molecule/backup/fixtures/**
!backup/tests/integration/fixtures/**

# Python / Ansible / Molecule
__pycache__/
*.pyc
.pytest_cache/
.molecule/
.cache/

# Audit reports (fetched from servers — may contain sensitive system info)
reports/

# Python venv
.venv/

# macOS
.DS_Store

# Editor
.vscode/
.idea/
*.swp
.claude