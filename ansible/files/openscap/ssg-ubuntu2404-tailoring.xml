<?xml version="1.0" ?>
<!--
  OpenSCAP XCCDF tailoring for the vps-scaffold cloud VPS.

  Base profile : xccdf_org.ssgproject.content_profile_cis_level1_server
                 (CIS Ubuntu 24.04 LTS Benchmark for Level 1 - Server, v1.0.0)
  Tailored id  : xccdf_org.ssgproject.content_profile_cis_level1_server_cloud_vps

  This file DESELECTS a small set of CIS L1 rules that are genuinely not
  applicable to a single-disk, single-tenant cloud VPS, so the OpenSCAP report
  separates "real residual failures" from "accepted, documented exceptions".
  Every deselection below is recorded in the exceptions register in
  docs/08-security-model.md — keep the two in lock-step.

  IMPORTANT: deselect ONLY controls we cannot satisfy without repartitioning the
  cloud image or attaching a console. Anything the scaffold can enforce stays
  selected and is driven to PASS by the Ansible roles (e.g. /tmp and /dev/shm
  mount options, usb-storage blacklist, AIDE) — do NOT add those here.

  Regenerate against a new SSG release with the "autotailor" tool (package
  openscap-utils): output to this file (-o), set the new profile id (-p), a title,
  one unselect flag (-u) per rule id below, then pass the datastream and the base
  profile id as positional arguments. Full command + rule list:
  docs/08-security-model.md.
-->
<xccdf-1.2:Tailoring xmlns:xccdf-1.2="http://checklists.nist.gov/xccdf/1.2" id="xccdf_auto_tailoring_default">
	<xccdf-1.2:benchmark href="ssg-ubuntu2404-ds.xml"/>
	<xccdf-1.2:version time="2026-06-01T00:00:00">1</xccdf-1.2:version>
	<xccdf-1.2:Profile id="xccdf_org.ssgproject.content_profile_cis_level1_server_cloud_vps" extends="xccdf_org.ssgproject.content_profile_cis_level1_server">
		<xccdf-1.2:title override="true">CIS Ubuntu 24.04 L1 Server - vps-scaffold cloud VPS tailoring</xccdf-1.2:title>
		<!-- Separate-partition mount options: /var, /var/log, /var/log/audit, /home
		     cannot carry nodev/nosuid/noexec without dedicated filesystems, which a
		     single-root cloud image does not have. CIS's own benchmark text accepts
		     the cloud-resize caveat for partitioning. N/A. -->
		<xccdf-1.2:select idref="xccdf_org.ssgproject.content_rule_mount_option_var_nodev" selected="false"/>
		<xccdf-1.2:select idref="xccdf_org.ssgproject.content_rule_mount_option_var_nosuid" selected="false"/>
		<xccdf-1.2:select idref="xccdf_org.ssgproject.content_rule_mount_option_var_log_nodev" selected="false"/>
		<xccdf-1.2:select idref="xccdf_org.ssgproject.content_rule_mount_option_var_log_noexec" selected="false"/>
		<xccdf-1.2:select idref="xccdf_org.ssgproject.content_rule_mount_option_var_log_nosuid" selected="false"/>
		<xccdf-1.2:select idref="xccdf_org.ssgproject.content_rule_mount_option_var_log_audit_nodev" selected="false"/>
		<xccdf-1.2:select idref="xccdf_org.ssgproject.content_rule_mount_option_var_log_audit_noexec" selected="false"/>
		<xccdf-1.2:select idref="xccdf_org.ssgproject.content_rule_mount_option_var_log_audit_nosuid" selected="false"/>
		<xccdf-1.2:select idref="xccdf_org.ssgproject.content_rule_mount_option_home_nodev" selected="false"/>
		<xccdf-1.2:select idref="xccdf_org.ssgproject.content_rule_mount_option_home_nosuid" selected="false"/>
		<!-- GRUB bootloader passwords: no physical/console access on a managed
		     hypervisor; recovery is via the provider console/rebuild. Setting a GRUB
		     password risks locking out provider rescue. N/A. -->
		<!-- Firewall architecture: the scaffold deliberately uses UFW (an nftables
		     frontend, live nft ruleset active and persistent) with Docker-aware
		     DOCKER-USER filtering. The benchmark's standalone-nftables path
		     (install nftables, disable its service until configured, define base
		     chains by hand) conflicts with that model. Same rationale as the L2
		     package_ufw_removed/service_nftables_enabled deselections. -->
		<xccdf-1.2:select idref="xccdf_org.ssgproject.content_rule_package_nftables_installed" selected="false"/>
		<xccdf-1.2:select idref="xccdf_org.ssgproject.content_rule_service_nftables_disabled" selected="false"/>
		<xccdf-1.2:select idref="xccdf_org.ssgproject.content_rule_set_nftables_base_chain" selected="false"/>
		<!-- Docker requires ip_forward=1; UFW (an nftables frontend) is the
		     scaffold's firewall, so the standalone-nftables service/persistence
		     rules and package_ufw_removed conflict with the architecture. All
		     four are documented in the docs/08 register (previously deselected
		     only in the L2 profile). -->
		<xccdf-1.2:select idref="xccdf_org.ssgproject.content_rule_sysctl_net_ipv4_ip_forward" selected="false"/>
		<xccdf-1.2:select idref="xccdf_org.ssgproject.content_rule_package_ufw_removed" selected="false"/>
		<xccdf-1.2:select idref="xccdf_org.ssgproject.content_rule_service_nftables_enabled" selected="false"/>
		<xccdf-1.2:select idref="xccdf_org.ssgproject.content_rule_nftables_rules_permanent" selected="false"/>
		<xccdf-1.2:select idref="xccdf_org.ssgproject.content_rule_grub2_password" selected="false"/>
		<xccdf-1.2:select idref="xccdf_org.ssgproject.content_rule_grub2_uefi_password" selected="false"/>
	</xccdf-1.2:Profile>
	<xccdf-1.2:Profile id="xccdf_org.ssgproject.content_profile_cis_level2_server_cloud_vps" extends="xccdf_org.ssgproject.content_profile_cis_level2_server">
		<xccdf-1.2:title override="true">CIS Ubuntu 24.04 L2 Server - vps-scaffold cloud VPS tailoring</xccdf-1.2:title>
		<!--
		  L2 cloud-VPS tailoring. Every deselection below is a documented exception
		  recorded in docs/08-security-model.md. Everything else in CIS L2 Server is
		  driven to PASS by the scaffold roles (baseline-hardening audit ruleset,
		  kernel-module blacklist, grub audit args, ssh DisableForwarding, pam/aide).
		  Keep this list and the exceptions register in lock-step.
		-->
		<!-- Separate partitions for /home, /var, /var/log, /var/log/audit, /var/tmp:
		     a single-root cloud image has one filesystem; creating these requires a
		     rebuild/repartition. CIS accepts the cloud-resize caveat. N/A. -->
		<xccdf-1.2:select idref="xccdf_org.ssgproject.content_rule_partition_for_home" selected="false"/>
		<xccdf-1.2:select idref="xccdf_org.ssgproject.content_rule_partition_for_var" selected="false"/>
		<xccdf-1.2:select idref="xccdf_org.ssgproject.content_rule_partition_for_var_log" selected="false"/>
		<xccdf-1.2:select idref="xccdf_org.ssgproject.content_rule_partition_for_var_log_audit" selected="false"/>
		<xccdf-1.2:select idref="xccdf_org.ssgproject.content_rule_partition_for_var_tmp" selected="false"/>
		<!-- GRUB bootloader passwords: no physical/console access on a managed
		     hypervisor; setting one risks locking out provider rescue. N/A. -->
		<xccdf-1.2:select idref="xccdf_org.ssgproject.content_rule_grub2_password" selected="false"/>
		<xccdf-1.2:select idref="xccdf_org.ssgproject.content_rule_grub2_uefi_password" selected="false"/>
		<!-- Firewall: this host uses UFW (an nftables frontend; live nft ruleset is
		     active and persistent). CIS's standalone-nftables path and "remove ufw"
		     rule conflict with that architecture. Accepted. -->
		<xccdf-1.2:select idref="xccdf_org.ssgproject.content_rule_package_ufw_removed" selected="false"/>
		<xccdf-1.2:select idref="xccdf_org.ssgproject.content_rule_service_nftables_enabled" selected="false"/>
		<xccdf-1.2:select idref="xccdf_org.ssgproject.content_rule_nftables_rules_permanent" selected="false"/>
		<!-- Docker requirements: the overlay module backs Docker's overlayfs storage
		     driver, and net.ipv4.ip_forward=1 is required for container networking.
		     Disabling either breaks Docker. Accepted on a Docker host. -->
		<xccdf-1.2:select idref="xccdf_org.ssgproject.content_rule_kernel_module_overlayfs_disabled" selected="false"/>
		<xccdf-1.2:select idref="xccdf_org.ssgproject.content_rule_sysctl_net_ipv4_ip_forward" selected="false"/>
		<!-- Passwordless sudo for the deploy user is required for unattended Ansible
		     provisioning and the ~/deploy release helper. Accepted; compensated by
		     key-only SSH, single-user access, and auditd rules on sudo/sudoers. -->
		<xccdf-1.2:select idref="xccdf_org.ssgproject.content_rule_sudo_require_authentication" selected="false"/>
		<!-- auditd disk-full / low-space actions: CIS wants single/halt, which would
		     drop a remote, console-less VPS offline on a full audit disk (self-DoS /
		     lockout). We keep SUSPEND + SYSLOG and rely on log rotation + monitoring.
		     Availability-over-strict-CIS exception. -->
		<xccdf-1.2:select idref="xccdf_org.ssgproject.content_rule_auditd_data_disk_error_action" selected="false"/>
		<xccdf-1.2:select idref="xccdf_org.ssgproject.content_rule_auditd_data_disk_full_action" selected="false"/>
		<xccdf-1.2:select idref="xccdf_org.ssgproject.content_rule_auditd_data_retention_admin_space_left_action" selected="false"/>
		<xccdf-1.2:select idref="xccdf_org.ssgproject.content_rule_auditd_data_retention_space_left_action" selected="false"/>
	</xccdf-1.2:Profile>
</xccdf-1.2:Tailoring>
