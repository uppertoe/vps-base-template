# backup.service — One-shot systemd service for database backups.
#
# Triggered by backup.timer. Do not enable this unit directly.
# Installed by the backup Ansible role.

[Unit]
Description=Database backup (restic → S3)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot

# Load global backup config (AWS creds, SMTP, retention).
# Per-service configs are sourced by the script itself.
EnvironmentFile=/etc/restic/config.env

ExecStart=/opt/backup/backup.sh

# Kill after 30 minutes to prevent a hung pg_dump blocking the next run.
# Restic uploads are resumable; no partial state is left in the repository.
TimeoutStartSec=30min

# Resource guardrails (cgroup v2): under contention, yield CPU and disk to the
# app tier (Caddy + containers run at the default weight of 100) and cap memory
# pressure. On the 2 GB host a backup that overlaps live traffic then slows down
# instead of starving the proxy or driving the box into swap. MemoryHigh is a
# soft throttle, not a kill — this data-protection job must still complete.
CPUWeight=20
IOWeight=20
MemoryHigh=512M

StandardOutput=journal
StandardError=journal
SyslogIdentifier=backup

[Install]
WantedBy=multi-user.target
