# restore-drill.service — Periodic proof that backups actually restore.
#
# Triggered by restore-drill.timer. Do not enable this unit directly.
# Installed by the backup Ansible role.
#
# Restores the latest snapshot of every service into a throwaway target
# (drill database / scratch dir), never touching live data, and records
# achieved RPO/RTO to /var/lib/backup-drill/. Failure fires OnFailure=notify@.

[Unit]
Description=Backup restore drill (RPO/RTO evidence)
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=oneshot

# Load global backup config (AWS creds, retention).
# Per-service configs are sourced by the script itself.
EnvironmentFile=/etc/restic/config.env

ExecStart=/opt/backup/restore-drill.sh

# Full-repo restores can be slow on cold object storage.
TimeoutStartSec=2h

# Resource guardrails (cgroup v2): the restic restore driven here is the single
# heaviest recurring host process, so yield CPU and disk to the app tier
# (default weight 100) under contention and soft-cap memory. On the 2 GB host
# the drill then throttles instead of starving Caddy or thrashing swap.
# (The drill DB import lands on the app DB container, governed separately.)
CPUWeight=20
IOWeight=20
MemoryHigh=512M

StandardOutput=journal
StandardError=journal
SyslogIdentifier=restore-drill

[Install]
WantedBy=multi-user.target
