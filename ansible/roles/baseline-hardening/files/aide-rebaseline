#!/bin/bash
# aide-rebaseline — rebuild the AIDE baseline to acknowledge legitimate changes.
#
# The daily AIDE check runs in 'check' (not 'update') mode, so a real change
# keeps alerting until acknowledged. The dominant source of legitimate change on
# a patched host is PACKAGE UPGRADES (e.g. unattended-upgrades touching /usr/bin,
# /usr/lib): those must NOT be whitelisted away — excluding /usr/bin would blind
# the tripwire to a backdoored binary, the exact thing AIDE exists to catch.
# Instead, treat apt as the trusted change channel: re-baseline AFTER package
# operations (see /etc/apt/apt.conf.d/80aide-rebaseline, debounced via the
# aide-rebaseline-after-apt timer). The second trusted channel is a DEPLOY that
# moves /opt/deploy's HEAD (vps-deploy restarts aide-rebaseline-after-deploy.timer)
# — with hands-off updates the working tree legitimately changes daily, and
# every deploy is itself gated (CI, signed HEAD) and announced via ntfy.
# Non-package, non-deploy tampering triggers neither channel and still alerts;
# auditd also catches config-path writes in real time.
#
# EVERY re-baseline is preceded by a recorded check: `aide --init` acknowledges
# the WHOLE tree, not just package paths, so the pre-check diff is written to
# the journal (shipped off-host, tamper-evident, by log-export) and a push
# notification announces what was acknowledged. A non-package change slipped in
# between two daily checks therefore still leaves a recorded, alerted trace
# instead of being silently legitimised.
#
# Idle CPU/IO priority is set by the unit. Idempotent.
set -eu

CONF=/etc/aide/aide.conf

# --- Pre-re-baseline check: record what is about to be acknowledged ---------
if [ -f /var/lib/aide/aide.db ]; then
  set +e
  check_out="$(aide --config="$CONF" --check 2>&1)"
  rc=$?
  set -e

  if [ "$rc" -eq 0 ]; then
    summary="no changes since last baseline"
  elif [ "$rc" -le 7 ]; then
    # aide exit bits: 1 = added, 2 = removed, 4 = changed
    # Match only the summary lines with trailing counts, not the detail-section
    # headers of the same name.
    summary="$(printf '%s\n' "$check_out" \
      | grep -E '(Added|Removed|Changed) entries:[[:space:]]+[0-9]+$' \
      | tr -s ' \t' ' ' | paste -sd',' -)"
    summary="${summary:-changes detected (rc=$rc)}"
    # Full diff into the journal — retained off-host via log-export.
    printf '%s\n' "$check_out" | tail -n 200 | logger -t aide-rebaseline
  else
    summary="pre-check errored (rc=$rc); baseline rebuilt anyway"
  fi

  logger -t aide-rebaseline "pre-rebaseline check: $summary"
  if [ -x /usr/local/bin/vps-notify ]; then
    # Triggered by either trusted change channel (apt post-invoke or a deploy
    # that moved /opt/deploy's HEAD); the journal shows which timer fired.
    /usr/local/bin/vps-notify \
      "AIDE baseline rebuilt" \
      "Acknowledging: ${summary}. Full diff: journalctl -t aide-rebaseline (also retained off-host via log-export)." \
      || true
  fi
fi

# --- Rebuild the baseline ----------------------------------------------------
aide --config="$CONF" --init
[ -f /var/lib/aide/aide.db.new ]    && cp -f /var/lib/aide/aide.db.new    /var/lib/aide/aide.db
[ -f /var/lib/aide/aide.db.new.gz ] && cp -f /var/lib/aide/aide.db.new.gz /var/lib/aide/aide.db.gz

# Hand mutable AIDE state back to the hardened daily unit's user. This script
# runs as root, so the files above (and aide's report log) come out root-owned
# — but dailyaidecheck runs as _aide, whose CAP_DAC_READ_SEARCH lets it READ
# root files while fs.protected_hardlinks still blocks it HARDLINKING the
# root-owned aide.log during rotation. Left root-owned, the daily check dies
# at rotation before comparing anything (seen live 2026-07-08/09).
chown _aide:_aide /var/lib/aide/aide.db /var/lib/aide/aide.db.gz 2>/dev/null || true
chown _aide:adm /var/log/aide/aide.log* 2>/dev/null || true

logger -t aide-rebaseline "AIDE baseline rebuilt"
