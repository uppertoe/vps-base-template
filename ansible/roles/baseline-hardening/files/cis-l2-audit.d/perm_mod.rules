-a always,exit -F arch=b32 -S chmod -S fchmodat -S fchmod -F auid>=1000 -F auid!=unset -F key=perm_mod
-a always,exit -F arch=b64 -S chmod -S fchmodat -S fchmod -F auid>=1000 -F auid!=unset -F key=perm_mod
-a always,exit -F arch=b32 -S lchown -S fchown -S chown -S fchownat -F auid>=1000 -F auid!=unset -F key=perm_mod
-a always,exit -F arch=b64 -S lchown -S fchown -S chown -S fchownat -F auid>=1000 -F auid!=unset -F key=perm_mod
-a always,exit -F arch=b32 -S lsetxattr -S fremovexattr -S lremovexattr -S fsetxattr -S removexattr -S setxattr -F auid>=1000 -F auid!=unset -F key=perm_mod
-a always,exit -F arch=b64 -S lsetxattr -S fremovexattr -S lremovexattr -S fsetxattr -S removexattr -S setxattr -F auid>=1000 -F auid!=unset -F key=perm_mod
-a always,exit -F arch=b32 -S lsetxattr -S fremovexattr -S lremovexattr -S fsetxattr -S removexattr -S setxattr -F auid=0 -F key=perm_mod
-a always,exit -F arch=b64 -S lsetxattr -S fremovexattr -S lremovexattr -S fsetxattr -S removexattr -S setxattr -F auid=0 -F key=perm_mod
