#!/usr/bin/env bash
# scaffold-drift-check — hands-off AWARENESS for the layer that is
# deliberately not auto-applied: alerts when the pinned scaffold submodule
# falls behind upstream main, so OS-layer changes (which carry UPGRADING.md
# operator actions) cannot silently accumulate.
set -euo pipefail

SCAFFOLD=/opt/deploy/scaffold
[[ -d "$SCAFFOLD" ]] || exit 0
cd "$SCAFFOLD"

runuser -u deploy -- git fetch --quiet origin main

behind="$(runuser -u deploy -- git rev-list --count HEAD..origin/main)"

if [[ "$behind" -eq 0 ]]; then
  exit 0
fi

/usr/local/bin/vps-notify "Scaffold ${behind} commit(s) behind upstream" \
  "Review UPGRADING.md entries newer than your pointer, bump the submodule, and re-run site-quick." || true
