#!/bin/bash
# vps-release-bind-check — before the first switch to the release tree, refuse
# when a running container binds a path under /opt/deploy that a release would
# not contain (untracked) or that the container writes to (a release is
# read-only once exported). docs/15-release-tree.md §6. A safety check, not a
# boundary: it asks the deploy account's checkout what git tracks.
set -euo pipefail
[[ -d /opt/deploy && ! -L /opt/deploy ]] || exit 0
bad=0
ids="$(docker ps -q)" || { echo "docker ps failed; cannot check bind mounts"; exit 1; }
while IFS=$'\t' read -r src rw; do
  rel="${src#/opt/deploy/}"
  if [[ "$rw" == true ]]; then
    echo "writable bind into the deploy tree: $rel"; bad=1; continue
  fi
  # A release exports the scaffold submodule at its recorded commit, so a path
  # under scaffold/ is tracked when the scaffold's own git tracks it.
  repo=/opt/deploy path="$rel"
  if [[ "$rel" == scaffold/* ]]; then repo=/opt/deploy/scaffold path="${rel#scaffold/}"; fi
  if runuser -u deploy -- git -C "$repo" ls-files --error-unmatch -- "$path" >/dev/null 2>&1; then
    continue
  fi
  # A whole file rendered from secrets/ (docs/13 "Whole files") is not tracked
  # itself; its ciphertext is, and the release renders it in the same place.
  if [[ "$repo" == /opt/deploy ]] && runuser -u deploy -- git -C /opt/deploy ls-files --error-unmatch -- "secrets/$rel.sops" >/dev/null 2>&1; then
    continue
  fi
  echo "untracked path bound from the deploy tree: $rel"; bad=1
done < <(printf '%s\n' "$ids" | xargs -r docker inspect --format '{{range .Mounts}}{{if eq .Type "bind"}}{{.Source}}{{"\t"}}{{.RW}}{{"\n"}}{{end}}{{end}}' | grep '^/opt/deploy/' | sort -u)
exit "$bad"
