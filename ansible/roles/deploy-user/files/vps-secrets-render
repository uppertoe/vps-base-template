#!/usr/bin/env python3
"""Render a server repo's SOPS-encrypted secrets into the .env files Compose reads.

Installed as /usr/local/sbin/vps-secrets-render (root, 0755) by the deploy-user
role, and run as root by vps-deploy (after the signed-commit check) and, in
default mode, by ./deploy through sudo. See docs/13-secrets.md.

Each encrypted file under <repo>/secrets/ mirrors the path of the file it
becomes, with ".sops" appended:

    secrets/.env.sops                    -> .env
    secrets/apps/planka/.env.sops        -> apps/planka/.env
    secrets/backup/services/planka.env.sops -> backup/services/planka.env

Only the env-file set that vps-deploy already locks to 0600 may be a target.
secrets/recovery.sops is never rendered: it is encrypted to the owner and
recovery keys only, and the server cannot (and must not) decrypt it.

Safety rules, because this runs as root inside a checkout the deploy user owns:

- Every file is decrypted before any is written. One failure writes nothing,
  so the running apps keep their current .env files.
- No path component is followed through a symlink, and new files are created
  with O_EXCL | O_NOFOLLOW relative to directory handles, then renamed into
  place. Root never writes through a link the deploy user planted.
- A file whose content has not changed is left untouched, so its ctime does
  not move and AIDE stays quiet.
- Decrypted content that sets a COMPOSE_* variable is refused, as vps-deploy
  refuses such a .env.
- Values are never printed.
"""

from __future__ import annotations

import argparse
import os
import pwd
import re
import stat
import subprocess
import sys

DEFAULT_REPO = "/opt/deploy"
DEFAULT_SOPS = "/usr/local/bin/sops"
DEFAULT_KEY = "/etc/vps-scaffold/age/key.txt"
SECRETS_DIR = "secrets"
SUFFIX = ".sops"
SKIP = {"recovery.sops", "README.md"}

# The env-file set vps-deploy locks to 0600. A name is one path component of
# letters, digits, dot, dash or underscore that does not start with a dot.
_NAME = r"[A-Za-z0-9_][A-Za-z0-9._-]*"
ALLOWED_TARGETS = [
    re.compile(r"^\.env$"),
    re.compile(rf"^apps/{_NAME}/\.env$"),
    re.compile(rf"^apps/{_NAME}/{_NAME}/\.env$"),
    re.compile(r"^backup/config\.env$"),
    re.compile(rf"^backup/services/{_NAME}\.env$"),
]
COMPOSE_VAR = re.compile(r"^\s*(export\s+)?COMPOSE_[A-Z_]*=", re.MULTILINE)


class RenderError(Exception):
    pass


def find_encrypted(repo_fd: int) -> list[str]:
    """Relative paths (under secrets/) of every *.sops file, refusing links."""
    try:
        top = os.open(SECRETS_DIR, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW, dir_fd=repo_fd)
    except FileNotFoundError:
        return []
    except OSError as e:
        raise RenderError(f"{SECRETS_DIR}/ is not a plain directory ({e.strerror})")
    found: list[str] = []

    def walk(fd: int, prefix: str) -> None:
        for name in sorted(os.listdir(fd)):
            rel = f"{prefix}{name}"
            st = os.stat(name, dir_fd=fd, follow_symlinks=False)
            if stat.S_ISLNK(st.st_mode):
                raise RenderError(f"{SECRETS_DIR}/{rel} is a symlink")
            if stat.S_ISDIR(st.st_mode):
                sub = os.open(name, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW, dir_fd=fd)
                try:
                    walk(sub, rel + "/")
                finally:
                    os.close(sub)
            elif stat.S_ISREG(st.st_mode):
                if rel in SKIP:
                    continue
                if not name.endswith(SUFFIX):
                    raise RenderError(f"{SECRETS_DIR}/{rel} is not a .sops file")
                found.append(rel)
            else:
                raise RenderError(f"{SECRETS_DIR}/{rel} is not a regular file")

    try:
        walk(top, "")
    finally:
        os.close(top)
    return found


def target_for(rel: str) -> str:
    target = rel[: -len(SUFFIX)]
    if not any(p.match(target) for p in ALLOWED_TARGETS):
        raise RenderError(f"{SECRETS_DIR}/{rel} would write {target}, which is not an env file this step may write")
    return target


def decrypt(sops: str, key: str, path: str) -> bytes:
    env = {
        "PATH": "/usr/sbin:/usr/bin:/sbin:/bin",
        "SOPS_AGE_KEY_FILE": key,
        "SOPS_DISABLE_VERSION_CHECK": "1",
        "HOME": "/root",
    }
    proc = subprocess.run(
        [sops, "--decrypt", "--input-type", "dotenv", "--output-type", "dotenv", path],
        env=env, stdout=subprocess.PIPE, stderr=subprocess.PIPE, check=False,
    )
    if proc.returncode != 0:
        # sops' own error names the file and the reason; it never prints values.
        reason = proc.stderr.decode(errors="replace").strip().splitlines()[-1:] or ["unknown error"]
        raise RenderError(f"could not decrypt {path}: {reason[0]}")
    return proc.stdout


def open_parent(repo_fd: int, target: str) -> int:
    """A handle on the target's directory, walked without following links."""
    fd = os.dup(repo_fd)
    for part in target.split("/")[:-1]:
        try:
            nxt = os.open(part, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW, dir_fd=fd)
        except OSError as e:
            os.close(fd)
            raise RenderError(f"{target}: {part}/ is missing or not a plain directory ({e.strerror})")
        os.close(fd)
        fd = nxt
    return fd


def current_content(dir_fd: int, name: str) -> bytes | None:
    try:
        fd = os.open(name, os.O_RDONLY | os.O_NOFOLLOW, dir_fd=dir_fd)
    except FileNotFoundError:
        return None
    except OSError:
        return None  # a link or something odd: replace it
    try:
        if not stat.S_ISREG(os.fstat(fd).st_mode):
            return None
        chunks = []
        while True:
            b = os.read(fd, 65536)
            if not b:
                break
            chunks.append(b)
        return b"".join(chunks)
    finally:
        os.close(fd)


def write_atomic(dir_fd: int, name: str, content: bytes, uid: int, gid: int) -> None:
    for attempt in range(5):
        tmp = f".{name}.vps-secrets.{os.getpid()}.{attempt}"
        try:
            fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, 0o600, dir_fd=dir_fd)
            break
        except FileExistsError:
            continue
    else:
        raise RenderError(f"could not create a temporary file beside {name}")
    try:
        os.fchown(fd, uid, gid)
        os.fchmod(fd, 0o600)
        view = memoryview(content)
        while view:
            n = os.write(fd, view)
            view = view[n:]
        os.fsync(fd)
    except BaseException:
        os.close(fd)
        try:
            os.unlink(tmp, dir_fd=dir_fd)
        except OSError:
            pass
        raise
    os.close(fd)
    # rename() replaces the name itself; it never follows a link at the target.
    os.rename(tmp, name, src_dir_fd=dir_fd, dst_dir_fd=dir_fd)


def main(argv: list[str]) -> int:
    ap = argparse.ArgumentParser(description=__doc__.splitlines()[0])
    ap.add_argument("--repo", default=DEFAULT_REPO)
    ap.add_argument("--sops", default=DEFAULT_SOPS)
    ap.add_argument("--key", default=DEFAULT_KEY)
    ap.add_argument("--owner", default="deploy", help="owner of the rendered files (the deploy user)")
    ap.add_argument("--check", action="store_true", help="decrypt and validate only; write nothing")
    args = ap.parse_args(argv)

    try:
        repo_fd = os.open(args.repo, os.O_RDONLY | os.O_DIRECTORY)
    except OSError as e:
        print(f"vps-secrets-render: cannot open {args.repo}: {e.strerror}", file=sys.stderr)
        return 1
    try:
        rels = find_encrypted(repo_fd)
        if not rels:
            return 0
        if not os.path.isfile(args.key):
            raise RenderError(f"{SECRETS_DIR}/ is present but the server key {args.key} is not")
        pw = pwd.getpwnam(args.owner)

        # Decrypt everything first: a single failure writes nothing.
        plan = []
        for rel in rels:
            target = target_for(rel)
            content = decrypt(args.sops, args.key, os.path.join(args.repo, SECRETS_DIR, rel))
            if COMPOSE_VAR.search(content.decode(errors="replace")):
                raise RenderError(f"{SECRETS_DIR}/{rel} sets a COMPOSE_* variable; compose behaviour must come from the tracked compose files")
            plan.append((rel, target, content))
        # Every target's directory must exist (and be a plain directory) before
        # anything is written, so a missing app folder cannot leave a half-applied set.
        for _, target, _ in plan:
            os.close(open_parent(repo_fd, target))
        targets = [t for _, t, _ in plan]
        dupes = {t for t in targets if targets.count(t) > 1}
        if dupes:
            raise RenderError(f"more than one secrets file writes {', '.join(sorted(dupes))}")
        if args.check:
            print(f"vps-secrets-render: {len(plan)} file(s) decrypt and validate")
            return 0

        for rel, target, content in plan:
            dir_fd = open_parent(repo_fd, target)
            try:
                name = target.rsplit("/", 1)[-1]
                if current_content(dir_fd, name) == content:
                    st = os.stat(name, dir_fd=dir_fd, follow_symlinks=False)
                    if (st.st_uid, st.st_gid, stat.S_IMODE(st.st_mode)) == (pw.pw_uid, pw.pw_gid, 0o600):
                        print(f"vps-secrets-render: {target} unchanged")
                        continue
                write_atomic(dir_fd, name, content, pw.pw_uid, pw.pw_gid)
                print(f"vps-secrets-render: {target} written")
            finally:
                os.close(dir_fd)
        return 0
    except RenderError as e:
        print(f"vps-secrets-render: {e} — nothing more was written, and the deploy must stop.", file=sys.stderr)
        return 1
    finally:
        os.close(repo_fd)


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
