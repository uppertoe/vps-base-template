#!/usr/bin/python3 -I
"""Render a server repo's SOPS-encrypted secrets into the .env files Compose reads.

Installed as /usr/local/sbin/vps-secrets-render (root, 0755) by the deploy-user
role, and run as root by vps-deploy (after the signed-commit check) and, in
default mode, by ./deploy through sudo. See docs/13-secrets.md.

Each encrypted file under <repo>/secrets/ mirrors the path of the file it
becomes, with ".sops" appended:

    secrets/.env.sops                       -> .env
    secrets/apps/planka/.env.sops           -> apps/planka/.env
    secrets/backup/services/planka.env.sops -> backup/services/planka.env

Only the env-file set that vps-deploy already locks to 0600 may be a target.
secrets/recovery.sops is never rendered: it is encrypted to the owner and
recovery keys only, and the server cannot (and must not) decrypt it.

A secrets file whose name does not end in ".env.sops" is a whole file (a
signing key, a user list), encrypted with sops' binary type and written back
byte for byte:

    secrets/apps/authelia/config/oidc.pem.sops -> apps/authelia/config/oidc.pem

A whole file may be written only below a subdirectory of an app
(apps/<app>/<dir>/.../<file>), so a rendered file is never a compose file, a
deploy hook or a Caddy snippet, which the deploy reads from the app's top
level. The dotenv checks (COMPOSE_* variables, carriage returns) do not apply
to it; an empty result is refused. The whole files this step has rendered are
recorded under --state-dir (root-only), and a recorded file whose secrets
file has since left the repo is removed at the next render, so a retired key
or user list does not linger in the deploy tree.

With --restic-dir, the backup set (backup/config.env and backup/services/*.env)
is also installed into that directory for restic, owned by the caller (root
under vps-deploy) with mode 0600, and a service file there that the repo no
longer carries is removed. The repo is then the only source of the restic
configuration (docs/13-secrets.md, Decision 2), and a retired service stops
being backed up at the next deploy. A repo without a backup set under secrets/
leaves the directory alone.

This runs as root inside a checkout the deploy user owns, so in restricted mode
it must not let that user write, read or hang anything they could not already.
The rules that follow from that:

- Every encrypted file is opened through directory handles with O_NOFOLLOW and
  O_NONBLOCK, checked to be a regular file of sensible size, read into memory,
  and handed to sops on stdin. sops never opens a path the deploy user could
  swap for a link to the server key or a FIFO.
- sops runs with an empty root-owned working directory and HOME, so it reads
  no .sops.yaml or dotfiles, and with age as its only decryption method. A
  file whose metadata names any key source other than age is refused before
  sops sees it, so a crafted file cannot send root's sops to a network
  endpoint.
- sops' own error output is never shown: for a malformed file it quotes the
  offending line, which could be a secret. A fixed message is printed instead.
- Every file is decrypted and validated before any is written. A write that
  fails part-way is reported with the number of files already replaced.
- New files are created with O_EXCL | O_NOFOLLOW relative to directory
  handles under a ".env." temporary name (which the wrapper's permission pass
  and .gitignore already treat as secret), then renamed into place. Stale
  temporary files from an interrupted run are removed first. Root never writes
  through a link the deploy user planted.
- A file whose content has not changed is left untouched, so its ctime does
  not move and AIDE stays quiet.
- Decrypted dotenv content that sets a COMPOSE_* or DOCKER_* variable, or holds
  a carriage return, is refused, as vps-deploy refuses such a .env.
- Values are never printed.
"""

from __future__ import annotations

import argparse
import json
import os
import pwd
import re
import shutil
import stat
import subprocess
import sys
import tempfile

DEFAULT_REPO = "/opt/deploy"
DEFAULT_SOPS = "/usr/local/bin/sops"
DEFAULT_KEY = "/etc/vps-scaffold/age/key.txt"
DEFAULT_STATE_DIR = "/var/lib/vps-secrets-render"
STATE_FILE = "rendered-files"
SECRETS_DIR = "secrets"
SUFFIX = ".sops"
DOTENV_SUFFIX = ".env" + SUFFIX
SKIP = {"recovery.sops", "README.md"}
MAX_BYTES = 1024 * 1024  # an env file this large is a mistake, not a secret
TMP_PREFIX = ".env.vps-secrets-tmp-"
TMP_PATTERN = re.compile(r"^\.env\.vps-secrets-tmp-\d+-\d+$")

# The env-file set vps-deploy locks to 0600. A name is one path component of
# letters, digits, dot, dash or underscore that does not start with a dot.
_NAME = r"[A-Za-z0-9_][A-Za-z0-9._-]*"
ALLOWED_TARGETS = [
    re.compile(r"^\.env$"),
    re.compile(rf"^apps/{_NAME}/\.env$"),
    re.compile(rf"^apps/{_NAME}/{_NAME}/\.env$"),
    re.compile(r"^backup/config\.env$"),
    re.compile(rf"^backup/services/{_NAME}\.env$"),
]
# A whole file lives below a subdirectory of an app. The deploy reads compose
# files, hooks and Caddy snippets from an app's top level only, so nothing
# rendered here is ever executed or assembled by the deploy itself.
FILE_TARGET = re.compile(rf"^apps/{_NAME}/(?:{_NAME}/)+{_NAME}$")
# Compose's dotenv grammar ends a key at '=' or ':' and trims spaces before the
# separator; DOCKER_* keys steer the CLI itself. Match what compose would read.
COMPOSE_VAR = re.compile(r"^\s*(export\s+)?(COMPOSE|DOCKER)_[A-Za-z0-9_.-]*\s*[=:]", re.MULTILINE)
RESTIC_CONFIG = "backup/config.env"
RESTIC_SERVICE = re.compile(rf"^backup/services/({_NAME}\.env)$")

# The metadata sops writes for an age-encrypted dotenv file, plus the encryption
# settings a .sops.yaml may add. Any other sops_ key (kms, gcp_kms, azure_kv,
# hc_vault, pgp, ...) names a key source that would make root's sops contact a
# service, so the file is refused.
ALLOWED_METADATA = re.compile(
    r"^sops_(age__list_\d+__map_(recipient|enc)|mac|lastmodified|version"
    r"|unencrypted_suffix|encrypted_suffix|unencrypted_regex|encrypted_regex"
    r"|unencrypted_comment_regex|encrypted_comment_regex|mac_only_encrypted"
    r"|shamir_threshold)$"
)
METADATA_KEY = re.compile(r"^(sops_[A-Za-z0-9_]*)=", re.MULTILINE)
# The same settings as sops writes them into the JSON document of a binary
# file: a "sops" object with these keys, and "data" holding the one encrypted
# value. Any other key under "sops" names a key source other than age.
FILE_METADATA_ALLOWED = {
    "age", "mac", "lastmodified", "version",
    "unencrypted_suffix", "encrypted_suffix", "unencrypted_regex", "encrypted_regex",
    "unencrypted_comment_regex", "encrypted_comment_regex", "mac_only_encrypted",
    "shamir_threshold",
}


class RenderError(Exception):
    pass


def _open_dir(name: str, dir_fd: int) -> int:
    return os.open(name, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW, dir_fd=dir_fd)


def _read_regular(name: str, dir_fd: int, what: str) -> bytes:
    """Read a regular file by name relative to dir_fd, never following a link
    and never blocking on a FIFO."""
    try:
        fd = os.open(name, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK, dir_fd=dir_fd)
    except OSError as e:
        raise RenderError(f"{what} could not be opened as a plain file ({e.strerror})")
    try:
        st = os.fstat(fd)
        if not stat.S_ISREG(st.st_mode):
            raise RenderError(f"{what} is not a regular file")
        if st.st_size > MAX_BYTES:
            raise RenderError(f"{what} is larger than {MAX_BYTES} bytes")
        chunks, total = [], 0
        while True:
            b = os.read(fd, 65536)
            if not b:
                break
            total += len(b)
            if total > MAX_BYTES:
                raise RenderError(f"{what} is larger than {MAX_BYTES} bytes")
            chunks.append(b)
        return b"".join(chunks)
    finally:
        os.close(fd)


def find_encrypted(repo_fd: int) -> list[tuple[str, bytes]]:
    """(relative path under secrets/, ciphertext) for every *.sops file, read
    through no-follow directory handles at the moment of the walk."""
    try:
        top = _open_dir(SECRETS_DIR, repo_fd)
    except FileNotFoundError:
        return []
    except OSError as e:
        raise RenderError(f"{SECRETS_DIR}/ is not a plain directory ({e.strerror})")
    found: list[tuple[str, bytes]] = []

    def walk(fd: int, prefix: str) -> None:
        for name in sorted(os.listdir(fd)):
            rel = f"{prefix}{name}"
            st = os.stat(name, dir_fd=fd, follow_symlinks=False)
            if stat.S_ISLNK(st.st_mode):
                raise RenderError(f"{SECRETS_DIR}/{rel} is a symlink")
            if stat.S_ISDIR(st.st_mode):
                try:
                    sub = _open_dir(name, fd)
                except OSError as e:
                    raise RenderError(f"{SECRETS_DIR}/{rel} is not a plain directory ({e.strerror})")
                try:
                    walk(sub, rel + "/")
                finally:
                    os.close(sub)
            elif stat.S_ISREG(st.st_mode):
                if rel in SKIP:
                    continue
                if not name.endswith(SUFFIX):
                    raise RenderError(f"{SECRETS_DIR}/{rel} is not a .sops file")
                found.append((rel, _read_regular(name, fd, f"{SECRETS_DIR}/{rel}")))
            else:
                raise RenderError(f"{SECRETS_DIR}/{rel} is not a regular file")

    try:
        walk(top, "")
    finally:
        os.close(top)
    return found


def is_dotenv(rel: str) -> bool:
    """A secrets file is a dotenv file when its name ends in .env.sops; any
    other name is a whole file carried byte for byte."""
    return rel.endswith(DOTENV_SUFFIX)


def target_for(rel: str) -> str:
    target = rel[: -len(SUFFIX)]
    if is_dotenv(rel):
        if not any(p.match(target) for p in ALLOWED_TARGETS):
            raise RenderError(f"{SECRETS_DIR}/{rel} would write {target}, which is not an env file this step may write")
    elif not FILE_TARGET.match(target):
        raise RenderError(f"{SECRETS_DIR}/{rel} would write {target}, which is not a file below a subdirectory of an app (apps/<app>/<dir>/<file>), the only place this step writes a whole file")
    return target


def check_metadata(rel: str, ciphertext: bytes) -> None:
    text = ciphertext.decode(errors="replace")
    keys = METADATA_KEY.findall(text)
    if "sops_mac" not in keys:
        raise RenderError(f"{SECRETS_DIR}/{rel} is not a SOPS-encrypted dotenv file")
    for k in keys:
        if not ALLOWED_METADATA.match(k):
            raise RenderError(f"{SECRETS_DIR}/{rel} names a key source other than age ({k}); only age keys are used here")


def check_file_metadata(rel: str, ciphertext: bytes) -> None:
    """A binary-type sops file is a JSON document with exactly "data" (the one
    encrypted value) and "sops" (the metadata). Anything else is refused
    before sops sees it, as for a dotenv file."""
    what = f"{SECRETS_DIR}/{rel}"
    try:
        doc = json.loads(ciphertext.decode("utf-8"))
    except (UnicodeDecodeError, ValueError):
        raise RenderError(f"{what} is not a SOPS-encrypted file (not the document sops writes for a binary file)")
    if not isinstance(doc, dict) or set(doc) != {"data", "sops"} or not isinstance(doc["sops"], dict):
        raise RenderError(f"{what} is not a SOPS-encrypted file (not the document sops writes for a binary file)")
    if not isinstance(doc["data"], str) or not doc["data"].startswith("ENC[AES256_GCM,"):
        raise RenderError(f"{what} holds content that is not encrypted")
    meta = doc["sops"]
    if "mac" not in meta:
        raise RenderError(f"{what} is not a SOPS-encrypted file (no mac)")
    for k in meta:
        if k not in FILE_METADATA_ALLOWED:
            raise RenderError(f"{what} names a key source other than age ({k}); only age keys are used here")
    age = meta.get("age", [])
    if not isinstance(age, list) or any(not isinstance(a, dict) or set(a) - {"recipient", "enc"} for a in age):
        raise RenderError(f"{what} carries age metadata in a form this step does not recognise")


def decrypt(sops: str, key: str, rel: str, ciphertext: bytes, workdir: str, kind: str = "dotenv") -> bytes:
    env = {
        "PATH": "/usr/sbin:/usr/bin:/sbin:/bin",
        "SOPS_AGE_KEY_FILE": key,
        "SOPS_DECRYPTION_ORDER": "age",
        "SOPS_DISABLE_VERSION_CHECK": "1",
        "HOME": workdir,
        "XDG_CONFIG_HOME": workdir,
    }
    try:
        proc = subprocess.run(
            [sops, "--decrypt", "--input-type", kind, "--output-type", kind, "/dev/stdin"],
            input=ciphertext, env=env, cwd=workdir,
            stdout=subprocess.PIPE, stderr=subprocess.PIPE, check=False, timeout=60,
        )
    except subprocess.TimeoutExpired:
        raise RenderError(f"{SECRETS_DIR}/{rel}: sops did not finish within 60 seconds")
    except OSError as e:
        raise RenderError(f"cannot run {sops} ({e.strerror})")
    if proc.returncode != 0:
        # Never echo sops' stderr: for a malformed file it quotes the line it
        # could not parse, which may be a secret. Name the likely cause instead.
        err = proc.stderr.decode(errors="replace")
        if "Failed to get the data key" in err:
            reason = "the server key cannot open it (is the server one of its recipients in .sops.yaml?)"
        elif "message authentication failed" in err or "MAC mismatch" in err:
            reason = "it has been altered or is corrupt"
        else:
            reason = "sops refused it (its own message is withheld because it can contain file content)"
        raise RenderError(f"could not decrypt {SECRETS_DIR}/{rel}: {reason}")
    return proc.stdout


def open_parent(repo_fd: int, target: str) -> int:
    """A handle on the target's directory, walked without following links."""
    fd = os.dup(repo_fd)
    for part in target.split("/")[:-1]:
        try:
            nxt = _open_dir(part, fd)
        except OSError as e:
            os.close(fd)
            raise RenderError(f"{target}: {part}/ is missing or not a plain directory ({e.strerror})")
        os.close(fd)
        fd = nxt
    return fd


def remove_stale_temps(dir_fd: int) -> None:
    """Delete temporary files an interrupted run left behind (they hold plaintext)."""
    for name in os.listdir(dir_fd):
        if TMP_PATTERN.match(name):
            try:
                os.unlink(name, dir_fd=dir_fd)
            except OSError:
                pass


def current_content(dir_fd: int, name: str) -> bytes | None:
    try:
        fd = os.open(name, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK, dir_fd=dir_fd)
    except OSError:
        return None  # missing, a link, or something odd: replace it
    try:
        if not stat.S_ISREG(os.fstat(fd).st_mode):
            return None
        chunks = []
        while True:
            b = os.read(fd, 65536)
            if not b:
                break
            chunks.append(b)
        return b"".join(chunks)
    finally:
        os.close(fd)


def write_atomic(dir_fd: int, name: str, content: bytes, uid: int, gid: int) -> None:
    for attempt in range(5):
        tmp = f"{TMP_PREFIX}{os.getpid()}-{attempt}"
        try:
            fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, 0o600, dir_fd=dir_fd)
            break
        except FileExistsError:
            continue
    else:
        raise RenderError(f"could not create a temporary file beside {name}")
    try:
        try:
            os.fchown(fd, uid, gid)
            os.fchmod(fd, 0o600)
            view = memoryview(content)
            while view:
                n = os.write(fd, view)
                view = view[n:]
            os.fsync(fd)
        finally:
            os.close(fd)
        # rename() replaces the name itself; it never follows a link at the target.
        os.rename(tmp, name, src_dir_fd=dir_fd, dst_dir_fd=dir_fd)
    except BaseException:
        try:
            os.unlink(tmp, dir_fd=dir_fd)
        except OSError:
            pass
        raise
    try:
        os.fsync(dir_fd)
    except OSError:
        pass


def install_restic(restic_dir: str, plan: list[tuple[str, str, bytes]]) -> int:
    """Install the rendered backup set into restic_dir (config.env and
    services/*.env), owned by the caller, and remove service files the set no
    longer names. Returns the number of files written or removed. Does nothing
    when the plan carries no backup set."""
    config = [c for _, t, c in plan if t == RESTIC_CONFIG]
    services = {m.group(1): c for _, t, c in plan for m in [RESTIC_SERVICE.match(t)] if m}
    if not config and not services:
        return 0
    if not config:
        raise RenderError(f"{SECRETS_DIR}/ holds backup service files but no backup/config.env; restic needs both")
    uid, gid = os.getuid(), os.getgid()
    changed = 0
    try:
        os.makedirs(os.path.join(restic_dir, "services"), mode=0o700, exist_ok=True)
        top = os.open(restic_dir, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW)
    except OSError as e:
        raise RenderError(f"{restic_dir} is not a usable directory ({e.strerror})")
    try:
        os.fchmod(top, 0o700)
        remove_stale_temps(top)
        if current_content(top, "config.env") != config[0]:
            write_atomic(top, "config.env", config[0], uid, gid)
            changed += 1
            print(f"vps-secrets-render: {restic_dir}/config.env written")
        sub_fd = _open_dir("services", top)
        try:
            os.fchmod(sub_fd, 0o700)
            remove_stale_temps(sub_fd)
            for name, content in sorted(services.items()):
                if current_content(sub_fd, name) != content:
                    write_atomic(sub_fd, name, content, uid, gid)
                    changed += 1
                    print(f"vps-secrets-render: {restic_dir}/services/{name} written")
            for name in sorted(os.listdir(sub_fd)):
                if name.endswith(".env") and name not in services:
                    st = os.stat(name, dir_fd=sub_fd, follow_symlinks=False)
                    if stat.S_ISREG(st.st_mode):
                        os.unlink(name, dir_fd=sub_fd)
                        changed += 1
                        print(f"vps-secrets-render: {restic_dir}/services/{name} removed (no longer in the repo)")
        finally:
            os.close(sub_fd)
    finally:
        os.close(top)
    return changed


def read_state(state_dir: str) -> dict[str, set[str]]:
    """The whole files earlier runs rendered, by repository path. Missing or
    unreadable state means nothing is known, which only means nothing is
    removed."""
    state: dict[str, set[str]] = {}
    try:
        with open(os.path.join(state_dir, STATE_FILE), encoding="utf-8") as f:
            for line in f:
                repo, sep, target = line.rstrip("\n").partition("\t")
                if sep and repo and target:
                    state.setdefault(repo, set()).add(target)
    except OSError:
        pass
    return state


def write_state(state_dir: str, state: dict[str, set[str]]) -> None:
    """Record the whole files rendered per repository, root-only. A repository
    path that no longer exists (a release directory since renamed or removed)
    is dropped, so the record does not grow with each release."""
    os.makedirs(state_dir, mode=0o700, exist_ok=True)
    os.chmod(state_dir, 0o700)
    lines = []
    for repo in sorted(state):
        if not os.path.isdir(repo):
            continue
        for target in sorted(state[repo]):
            lines.append(f"{repo}\t{target}\n")
    tmp = os.path.join(state_dir, STATE_FILE + ".tmp")
    fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_TRUNC | os.O_NOFOLLOW, 0o600)
    try:
        os.write(fd, "".join(lines).encode("utf-8"))
        os.fsync(fd)
    finally:
        os.close(fd)
    os.rename(tmp, os.path.join(state_dir, STATE_FILE))


def remove_rendered(repo_fd: int, target: str, uid: int) -> bool:
    """Remove a whole file this step rendered earlier, through no-follow
    handles, and only if what sits at the path is a plain file owned by the
    account this step writes for. Anything else is left alone."""
    try:
        dir_fd = open_parent(repo_fd, target)
    except RenderError:
        return False  # its directory is gone, and so is the file
    try:
        name = target.rsplit("/", 1)[-1]
        try:
            st = os.stat(name, dir_fd=dir_fd, follow_symlinks=False)
        except FileNotFoundError:
            return False
        if not stat.S_ISREG(st.st_mode) or st.st_uid != uid:
            return False
        os.unlink(name, dir_fd=dir_fd)
        return True
    finally:
        os.close(dir_fd)


def main(argv: list[str]) -> int:
    ap = argparse.ArgumentParser(description=__doc__.splitlines()[0])
    ap.add_argument("--repo", default=DEFAULT_REPO)
    ap.add_argument("--sops", default=DEFAULT_SOPS)
    ap.add_argument("--key", default=DEFAULT_KEY)
    ap.add_argument("--owner", default="deploy", help="owner of the rendered files (the deploy user)")
    ap.add_argument("--check", action="store_true", help="decrypt and validate only; write nothing")
    ap.add_argument("--restic-dir", default=None,
                    help="also install the rendered backup set here for restic (vps-deploy passes /etc/restic)")
    ap.add_argument("--state-dir", default=DEFAULT_STATE_DIR,
                    help="root-only record of the whole files rendered, so one whose secrets file is gone is removed")
    args = ap.parse_args(argv)

    try:
        repo_fd = os.open(args.repo, os.O_RDONLY | os.O_DIRECTORY)
    except OSError as e:
        print(f"vps-secrets-render: cannot open {args.repo}: {e.strerror}", file=sys.stderr)
        return 1
    workdir = tempfile.mkdtemp(prefix="vps-secrets-render.", dir="/run" if os.access("/run", os.W_OK) else None)
    written = 0
    try:
        files = find_encrypted(repo_fd)
        repo_key = os.path.realpath(args.repo)
        state = read_state(args.state_dir)
        if not files and not state.get(repo_key):
            return 0
        if files and not os.path.isfile(args.key):
            raise RenderError(f"{SECRETS_DIR}/ is present but the server key {args.key} is not")
        pw = pwd.getpwnam(args.owner)

        # Decrypt and validate everything first: a single failure writes nothing.
        plan = []
        for rel, ciphertext in files:
            target = target_for(rel)
            if is_dotenv(rel):
                check_metadata(rel, ciphertext)
                content = decrypt(args.sops, args.key, rel, ciphertext, workdir)
                text = content.decode(errors="replace")
                if "\r" in text:
                    raise RenderError(f"{SECRETS_DIR}/{rel} decrypts to content with a carriage return, which compose could read as a line break")
                if COMPOSE_VAR.search(text):
                    raise RenderError(f"{SECRETS_DIR}/{rel} sets a COMPOSE_* or DOCKER_* variable; compose behaviour must come from the tracked compose files")
            else:
                check_file_metadata(rel, ciphertext)
                content = decrypt(args.sops, args.key, rel, ciphertext, workdir, kind="binary")
                if not content:
                    raise RenderError(f"{SECRETS_DIR}/{rel} decrypts to an empty file, which is a mistake rather than a secret")
            plan.append((rel, target, content))
        targets = [t for _, t, _ in plan]
        dupes = {t for t in targets if targets.count(t) > 1}
        if dupes:
            raise RenderError(f"more than one secrets file writes {', '.join(sorted(dupes))}")
        # Every target's directory must exist (and be a plain directory) before
        # anything is written, so a missing app folder cannot leave a half-applied set.
        for _, target, _ in plan:
            os.close(open_parent(repo_fd, target))
        if args.check:
            print(f"vps-secrets-render: {len(plan)} file(s) decrypt and validate")
            return 0

        for rel, target, content in plan:
            dir_fd = open_parent(repo_fd, target)
            try:
                remove_stale_temps(dir_fd)
                name = target.rsplit("/", 1)[-1]
                if current_content(dir_fd, name) == content:
                    st = os.stat(name, dir_fd=dir_fd, follow_symlinks=False)
                    if (st.st_uid, st.st_gid, stat.S_IMODE(st.st_mode)) == (pw.pw_uid, pw.pw_gid, 0o600):
                        print(f"vps-secrets-render: {target} unchanged")
                        continue
                write_atomic(dir_fd, name, content, pw.pw_uid, pw.pw_gid)
                written += 1
                print(f"vps-secrets-render: {target} written")
            finally:
                os.close(dir_fd)
        if args.restic_dir:
            written += install_restic(args.restic_dir, plan)

        # A whole file rendered earlier whose secrets file has left the repo
        # is removed, so a retired key or user list does not stay in use.
        # Dotenv targets are not recorded: compose reads them by name from
        # the tracked compose files, and vps-deploy locks the whole set.
        current = {t for r, t, _ in plan if not is_dotenv(r)}
        for target in sorted(state.get(repo_key, set()) - current):
            if remove_rendered(repo_fd, target, pw.pw_uid):
                written += 1
                print(f"vps-secrets-render: {target} removed (its secrets file is no longer in the repo)")
        state[repo_key] = current
        try:
            write_state(args.state_dir, state)
        except OSError as e:
            print(f"vps-secrets-render: could not record the rendered whole files in {args.state_dir} ({e.strerror}); a later removal may be missed", file=sys.stderr)
        return 0
    except RenderError as e:
        done = f" {written} file(s) had already been replaced." if written else " Nothing was written."
        print(f"vps-secrets-render: {e}.{done} The deploy must stop.", file=sys.stderr)
        return 1
    except OSError as e:
        print(f"vps-secrets-render: {e.strerror or e} while writing; {written} file(s) had already been replaced. The deploy must stop.", file=sys.stderr)
        return 1
    finally:
        os.close(repo_fd)
        shutil.rmtree(workdir, ignore_errors=True)


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
