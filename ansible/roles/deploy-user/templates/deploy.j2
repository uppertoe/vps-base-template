#!/usr/bin/env bash
# deploy — pull latest changes, run optional app hooks, and restart containers.
# Run from anywhere: ~/deploy
# Managed by Ansible (deploy-user role).
{% if deploy_restricted_mode | bool or deploy_release_tree | default(false) | bool %}
# Restricted mode, or the release tree (docs/15-release-tree.md): all the work
# happens in the root-owned wrapper. See docs/05-access-model.md.
exec sudo /usr/local/sbin/vps-deploy "$@"
{% else %}
set -euo pipefail

cd /opt/deploy

# HEAD is captured either side of the pull: a moved HEAD means the
# AIDE-monitored working tree legitimately changed, which the tail of this
# script acknowledges (mirrors vps-deploy, the restricted-mode path).
old_head="$(git rev-parse HEAD)"
git pull --recurse-submodules
new_head="$(git rev-parse HEAD)"
# Secrets (docs/13-secrets.md): the render step runs as root, because only root
# reads the server's age key; in default mode the deploy user may sudo. A backup
# set under secrets/backup/ is installed into /etc/restic by the same step.
if [[ -d secrets ]]; then
  sudo -n /usr/local/sbin/vps-secrets-render --repo /opt/deploy --restic-dir /etc/restic
fi
docker compose pull --policy always

# Keep server and app env files readable only by the deploy user. Only chmod
# files that are not already 600 — an unconditional chmod bumps ctime on every
# deploy and trips the AIDE tripwire on the deployed tree for no real change.
find . \
  \( -path './.env' -o -path './apps/*/.env' -o -path './backup/config.env' -o -path './backup/services/*.env' \) \
  -type f ! -perm 600 -exec chmod 600 {} +

# The inverse pass: containers run as dedicated non-root uids and bind-mount
# repo files (compose configs, Caddy snippets, app config like sites.yaml).
# Files (re)created by git pull under the deploy user's hardened umask lack
# the world-readable bit, so they are unreadable inside any container whose
# uid is not the deploy user's — readability must not depend on that
# coincidence. Normalise the container-consumed tree to world-readable,
# conditionally for the same ctime/AIDE reason as above. Secrets are exactly
# the .env set locked to 600 above and the whole files rendered from secrets/
# (docs/13 "Whole files", named after their secrets file without ".sops"),
# and are excluded here.
rendered_prune=()
if [[ -d secrets ]]; then
  while IFS= read -r -d '' f; do
    rendered_prune+=(-o -path "./${f#./secrets/}")
  done < <(find ./secrets -type f -name '*.sops' ! -name '*.env.sops' ! -path './secrets/recovery.sops' -print0 | sed -z 's/\.sops$//')
fi
find ./apps ./scaffold ./.generated ./Caddyfile \
  \( -name '.env' -o -name '.env.*' "${rendered_prune[@]}" \) -prune \
  -o -type f ! -perm -0004 -exec chmod o+r {} + \
  -o -type d ! -perm -0005 -exec chmod o+rx {} +

for hook in ./apps/*/deploy.sh; do
  if [[ -x "$hook" ]]; then
    echo "Running app deploy hook: ${hook#./}"
    "$hook"
  fi
done

docker compose up -d --remove-orphans --wait --force-recreate

# Every digest bump strands the superseded image (untagged, unreferenced), and
# nothing else on the host reclaims them — left alone they fill the disk at
# roughly the pace Renovate merges. Prune only after --wait has confirmed the
# new containers healthy; anything removed is pinned in git and re-pullable
# from the registry, so rollback is a re-pull, not a loss. Images (not
# volumes) only, and non-fatal: the deploy itself has already succeeded, and
# a failed prune costs disk, not availability.
docker image prune -af || true

# The deploy changed /opt/deploy's working tree (AIDE-monitored): acknowledge
# via the evidence-recording re-baseline, debounced so back-to-back deploys
# rebaseline once — same trusted-channel contract as vps-deploy. Default
# mode's deploy user holds broad sudo; -n keeps a passwordless-sudo-less host
# from hanging, and the guard tolerates hosts without the AIDE stack.
if [[ "$old_head" != "$new_head" ]]; then
  sudo -n systemctl restart aide-rebaseline-after-deploy.timer >/dev/null 2>&1 || true
fi
{% endif %}
