# {{ ansible_managed }}
# Read by /usr/local/sbin/vps-release (docs/15-release-tree.md).
REPO_URL={{ deploy_release_repo_url }}
BRANCH={{ deploy_branch }}
KEEP={{ deploy_release_keep }}
VERIFY_SIGNATURE={{ '1' if deploy_verify_signature | bool else '0' }}
# Read by vps-deploy: a deploy whose acceptance probes fail, and that ran no
# app hook, is rolled back to the previous release when this is 1 (docs/15).
PROBE_ROLLBACK={{ '1' if deploy_probe_rollback | default(true) | bool else '0' }}
