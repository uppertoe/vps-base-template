#!/bin/bash
# vps-deploy — root-owned deploy entrypoint (managed by Ansible, deploy-user role).
#
# In restricted mode this is the ONLY supported way for the deploy user to
# trigger app-level container operations: sudoers allowlists exactly this
# path, the working directory is fixed, and the environment is reset. The
# deploy user's ~/deploy helper calls `sudo vps-deploy`.
#
# Privilege split inside the run: git operates AS the deploy user (repo
# ownership stays intact); docker/compose, env-permission normalisation and
# app hooks run as root.
set -euo pipefail
export PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
umask 022

{% if deploy_release_tree | default(false) | bool %}
# Release tree: start from /, so a missing or dangling /opt/deploy link (an
# interrupted switch) cannot stop the wrapper that repairs it.
cd /
{% else %}
cd /opt/deploy
{% endif %}

# Hand back anything under .git that a hand-run root git has taken (a root-owned
# index stops the deploy account's pull). Logged and announced by the helper.
/usr/local/sbin/vps-git-heal || true

# Never deploy while apt is mid-flight. On prod-rch-vps (2026-09-05) an
# auto-deploy started during a docker-ce/containerd upgrade: containerd refused
# the freshly created Authelia container ("failed to start shim") and it sat
# in Created for 2.5 h while everything else stayed up under live-restore.
# Wait (up to 30 min) for unattended-upgrades to finish and the dpkg lock to
# clear before touching the stack.
# NOTE: unattended-upgrades.service is NOT a signal -- it is a boot-time
# RemainAfterExit unit (its job is to block shutdown mid-upgrade) and reads
# "active" all day, which made every deploy sit out the full 30 min. Only the
# apt-daily oneshots, a live unattended-upgrade process, or a held dpkg lock
# mean apt is actually working.
# backup.service dumps every database; recreating a DB container under it
# fails the dump (roster-insights, 2026-09-06 04:08 UTC). Wait for that too.
# The AIDE scan and rebaseline hold the single vCPU for a quarter of an hour,
# and containers recreated under them miss their health deadline and fail the
# deploy (prod-rch-vps, 2026-11-02 02:29 UTC). Wait for those as well.
apt_busy() {
  for u in apt-daily.service apt-daily-upgrade.service backup.service backup-verify.service \
           dailyaidecheck.service aide-rebaseline.service; do
    case "$(systemctl show -p ActiveState --value "$u" 2>/dev/null)" in
      active|activating|deactivating) return 0 ;;
    esac
  done
  pgrep -f '^/usr/bin/python3 /usr/bin/unattended-upgrade' >/dev/null 2>&1 && return 0
  command -v fuser >/dev/null 2>&1 && fuser /var/lib/dpkg/lock-frontend >/dev/null 2>&1 && return 0
  return 1
}
apt_wait_deadline=$(( $(date +%s) + 1800 ))
while apt_busy; do
  if [[ $(date +%s) -ge $apt_wait_deadline ]]; then
    echo "vps-deploy: apt still busy after 30 min — proceeding anyway." >&2
    break
  fi
  echo "vps-deploy: apt, backup or AIDE in progress; waiting…"
  sleep 20
done

# Arguments. The deploy account's sudoers allows the bare command only; the
# other forms are for root and the admin account.
#   --auto          the auto-deploy unit: a held commit is skipped (exit 3)
#   --rollback      release tree only: switch back to the previous release
#   --allow-rewind  accept a HEAD that is not a descendant of the last deployed
#                   commit (see the rewind guard below)
action=deploy allow_rewind=0
for arg in "$@"; do
  case "$arg" in
    --rollback) action=rollback ;;
    # auto-deploy: the hold is re-checked under the lock, so a rollback that
    # finished while this run waited is not undone.
    --auto) action=auto ;;
    --allow-rewind) allow_rewind=1 ;;
    *) echo "usage: vps-deploy [--auto] [--rollback] [--allow-rewind]" >&2; exit 2 ;;
  esac
done
{% if not deploy_release_tree | default(false) | bool %}
if [[ "$action" == rollback ]]; then
  echo "vps-deploy: --rollback needs the release tree (docs/15-release-tree.md)." >&2
  exit 2
fi
{% endif %}

# Rewind guard. Every check below accepts any validly signed commit, so an
# older commit that carries a vulnerable image or predates a security fix
# would pass them all. Root keeps its own record of the last commit it
# deployed and refuses a HEAD that does not descend from it, unless this is a
# rollback (which the release tool verifies again) or the admin account passed
# --allow-rewind on purpose. The record is root-owned: the deploy account
# cannot move it. is_ancestor is defined per mode below.
last_deployed_file=/var/lib/vps-deploy/last-deployed
rewind_guard() {  # rewind_guard NEW_HEAD
  local last
  last="$(cat "$last_deployed_file" 2>/dev/null || true)"
  [[ "$last" =~ ^[0-9a-f]{40}$ ]] || return 0
  [[ "$last" == "$1" ]] && return 0
  if ! is_ancestor "$last" "$1"; then
    if [[ "$action" == rollback || "$allow_rewind" == 1 ]]; then
      echo "vps-deploy: $1 does not descend from the last deployed commit ${last:0:7}; proceeding ($action, allow_rewind=$allow_rewind)." >&2
      return 0
    fi
    echo "vps-deploy: HEAD $1 is not a descendant of the last deployed commit ${last:0:7} — a rewind to an older commit is refused. An administrator can run 'sudo vps-deploy --allow-rewind' on purpose." >&2
    exit 1
  fi
}
record_deployed() {  # record_deployed HEAD
  install -d -m 0700 -o root -g root /var/lib/vps-deploy
  (umask 077; printf '%s\n' "$1" > "$last_deployed_file.tmp") && mv -f "$last_deployed_file.tmp" "$last_deployed_file"
}

{% if deploy_release_tree | default(false) | bool %}
# Release tree (docs/15-release-tree.md). Root fetches the server repo into its
# own mirror, verifies the tip, exports it into /opt/deploy-releases/<commit>
# as root-owned files and renders the secrets there; only then is /opt/deploy
# switched to it. Nothing the deploy account can write is read or executed,
# and a failure before the switch leaves the running release untouched.
# The project name is fixed, because /opt/deploy is now a symlink and Compose
# must not name the project after the release directory.
export COMPOSE_PROJECT_NAME=deploy
# One deploy at a time: a release prepared by one run must not be pruned or
# switched away by another before it goes live.
exec 9>/run/vps-deploy.lock
if ! flock -w 1800 9; then
  echo "vps-deploy: another deploy has held the lock for 30 min — giving up." >&2
  exit 1
fi
is_ancestor() {
  env -i PATH="$PATH" HOME=/root GIT_CONFIG_NOSYSTEM=1 GIT_CONFIG_GLOBAL=/dev/null GIT_NO_REPLACE_OBJECTS=1 \
    git --git-dir=/var/lib/vps-deploy/repo.git -c core.hooksPath=/dev/null merge-base --is-ancestor "$1" "$2" 2>/dev/null
}
release_field() { sed -n "s/^$2=//p" "$1/.release" 2>/dev/null; }
old_head="$(/usr/local/sbin/vps-release current)"
if [[ -L /opt/deploy ]]; then
  old_scaffold="$(release_field "$(readlink -f /opt/deploy)" scaffold)"
else
  old_scaffold="$(runuser -u {{ deploy_user }} -- git -C /opt/deploy/scaffold rev-parse HEAD 2>/dev/null || echo none)"
fi
if [[ "$action" == rollback ]]; then
  release="$(/usr/local/sbin/vps-release previous)"
  if [[ -z "$release" ]]; then
    echo "vps-deploy: there is no earlier release to roll back to." >&2
    exit 1
  fi
  # A kept release is verified again: a signer may have been removed since.
  /usr/local/sbin/vps-release recheck "$release"
else
  release="$(/usr/local/sbin/vps-release prepare)"
fi
if [[ ! "$release" =~ ^/opt/deploy-releases/[0-9a-f]{40}$ || ! -f "$release/.release" ]]; then
  echo "vps-deploy: vps-release returned '$release', which is not a release — refusing to deploy." >&2
  exit 1
fi
new_head="$(release_field "$release" commit)"
new_scaffold="$(release_field "$release" scaffold)"
if [[ "$action" == auto && "$new_head" == "$(/usr/local/sbin/vps-release held)" ]]; then
  echo "vps-deploy: ${new_head:0:7} is held after a rollback; not deploying it."
  exit 3
fi
if [[ "$action" != rollback && "$new_head" == "$old_head" ]]; then
  echo "vps-deploy: ${new_head:0:7} is already deployed; recreating its containers."
fi
# Compose reads COMPOSE_FILE and friends from the project's .env; even from
# reviewed ciphertext they would steer root's compose. Override files would be
# merged silently. Both are refused, as in checkout mode.
if grep -Eq '^[[:space:]]*(export[[:space:]]+)?(COMPOSE|DOCKER)_[A-Za-z0-9_.-]*[[:space:]]*[=:]' "$release/.env" 2>/dev/null; then
  echo "vps-deploy: .env sets a COMPOSE_* or DOCKER_* variable; compose behaviour must come from the tracked compose files — refusing to deploy." >&2
  exit 1
fi
for f in docker-compose.override.yml docker-compose.override.yaml compose.override.yml compose.override.yaml; do
  if [[ -e "$release/$f" ]]; then
    echo "vps-deploy: $f is in the release — compose would merge it; refusing to deploy." >&2
    exit 1
  fi
done
# Pull before the switch, so an unreachable registry fails the deploy while
# the running release is still in place.
rewind_guard "$new_head"
(cd "$release" && docker compose pull --policy always)
/usr/local/sbin/vps-release switch "$release"
# A rollback holds auto-deploy off the commit rolled back from until a new
# commit arrives; any other deploy clears the hold.
if [[ "$action" == rollback ]]; then
  [[ "$old_head" =~ ^[0-9a-f]{40}$ ]] && /usr/local/sbin/vps-release hold "$old_head"
else
  /usr/local/sbin/vps-release unhold
fi
cd /opt/deploy
{% else %}
# Update the repo as the unprivileged owner, never as root. HEAD is captured
# either side of the pull: a moved HEAD means the AIDE-monitored working tree
# legitimately changed, which the tail of this script acknowledges.
# GIT_NO_REPLACE_OBJECTS: a refs/replace entry in the deploy-owned .git would
# otherwise let every git command below (the checks, the signature gate, the
# tree root reads) see a different object than the one at HEAD. Exported so
# both the deploy-user and root invocations ignore replacements.
export GIT_NO_REPLACE_OBJECTS=1
# GIT_OPTIONAL_LOCKS=0: the root-side git reads below must never write the
# deploy-owned index. Without it a status-style refresh can rewrite .git/index
# as root (seen 2026-11-01 after a bind-mounted directory changed owner), and
# the deploy user's next pull fails with "index file open failed".
export GIT_OPTIONAL_LOCKS=0
old_head="$(runuser -u {{ deploy_user }} -- git rev-parse HEAD)"
old_scaffold="$(runuser -u {{ deploy_user }} -- git -C scaffold rev-parse HEAD 2>/dev/null || echo none)"
runuser -u {{ deploy_user }} -- git pull --recurse-submodules
new_head="$(runuser -u {{ deploy_user }} -- git rev-parse HEAD)"
new_scaffold="$(runuser -u {{ deploy_user }} -- git -C scaffold rev-parse HEAD 2>/dev/null || echo none)"

# Root-side git reads. Every check that decides what root is about to execute
# runs as root with an isolated configuration: no system or global config, the
# deploy-owned repository config outranked on the command line for the keys
# that select programs or hide changes, replacement objects ignored, and a
# PRIVATE COPY of the index so the stat refresh the comparison needs is written
# to a root-owned temporary file and never to the deploy-owned index. The
# deploy account's own git configuration therefore cannot change the answer
# (the 2026-11-02 review: fsmonitor and submodule-ignore settings in a config
# that account writes would otherwise have been consulted).
root_tmp="$(mktemp -d /run/vps-deploy.XXXXXX)"
trap 'rm -rf "$root_tmp"' EXIT
# The repository must be a plain directory at the expected place: a gitfile or
# a link there would let the deploy account point root's reads elsewhere.
if [[ -L /opt/deploy/.git || ! -d /opt/deploy/.git ]]; then
  echo "vps-deploy: /opt/deploy/.git is not a plain directory — refusing to deploy." >&2
  exit 1
fi
if [[ -L /opt/deploy/.git/index || ! -f /opt/deploy/.git/index ]]; then
  echo "vps-deploy: /opt/deploy/.git/index is not a plain file — refusing to deploy." >&2
  exit 1
fi
cp --no-preserve=all /opt/deploy/.git/index "$root_tmp/index"
# GIT_DIR and GIT_WORK_TREE are passed explicitly: the environment outranks
# core.worktree in the deploy-owned config, which could otherwise point the
# clean-tree comparison at a different directory (2026-11-03 review).
rootgit() {
  env -i PATH="$PATH" HOME=/root GIT_CONFIG_NOSYSTEM=1 GIT_CONFIG_GLOBAL=/dev/null \
      GIT_NO_REPLACE_OBJECTS=1 GIT_OPTIONAL_LOCKS=0 GIT_INDEX_FILE="$root_tmp/index" \
      GIT_DIR=/opt/deploy/.git GIT_WORK_TREE=/opt/deploy \
    git -C /opt/deploy -c safe.directory=/opt/deploy -c core.hooksPath=/dev/null \
      -c core.fsmonitor=false -c diff.ignoreSubmodules=none -c submodule.scaffold.ignore=none "$@"
}
# The scaffold submodule's git directory is where git keeps it; root does not
# ask the deploy account where it is. A real directory there, or no submodule.
scaffold_gitdir=/opt/deploy/.git/modules/scaffold
if [[ -e "$scaffold_gitdir" ]]; then
  if [[ -L "$scaffold_gitdir" || ! -d "$scaffold_gitdir" || -L "$scaffold_gitdir/index" || ! -f "$scaffold_gitdir/index" ]]; then
    echo "vps-deploy: $scaffold_gitdir is not a plain git directory — refusing to deploy." >&2
    exit 1
  fi
  cp --no-preserve=all "$scaffold_gitdir/index" "$root_tmp/scaffold-index"
fi
rootgit_scaffold() {
  env -i PATH="$PATH" HOME=/root GIT_CONFIG_NOSYSTEM=1 GIT_CONFIG_GLOBAL=/dev/null \
      GIT_NO_REPLACE_OBJECTS=1 GIT_OPTIONAL_LOCKS=0 GIT_INDEX_FILE="$root_tmp/scaffold-index" \
      GIT_DIR="$scaffold_gitdir" GIT_WORK_TREE=/opt/deploy/scaffold \
    git -C /opt/deploy/scaffold -c safe.directory=/opt/deploy/scaffold -c safe.directory=/opt/deploy \
      -c core.hooksPath=/dev/null -c core.fsmonitor=false "$@"
}
is_ancestor() { rootgit merge-base --is-ancestor "$1" "$2" 2>/dev/null; }
# The deploy-owned repository configuration is still read by every root-side
# git call. Reading it runs nothing, so read it first and refuse any key that
# would make a later call run a program (a clean or smudge filter during the
# index refresh, an external diff or textconv, a different signing program),
# redirect the work tree, or pull in another file. The keys pinned on the
# command line above are refused here as well, so the two cannot drift. The
# same applies to the submodule's configuration and to the attributes file
# under either git directory, which could select such a filter.
# Git itself writes core.worktree=../../../scaffold into the submodule's own
# configuration; that one exact value is expected there, and the work tree is
# passed explicitly regardless. Any other value, or the key in the
# superproject, is refused.
config_refused() {  # config_refused <git-fn> [expected-worktree]: prints offending lines
  "$1" config --list --show-origin 2>/dev/null | grep '^file:' | cut -f2- \
    | { if [[ -n "${2:-}" ]]; then grep -vxF "core.worktree=$2"; else cat; fi; } \
    | grep -Ei '^(filter\.|diff\.[^=]*\.(textconv|command)=|diff\.external=|core\.worktree=|core\.attributesfile=|include\.|includeif\.|core\.hookspath=|core\.fsmonitor=|gpg\.|core\.sshcommand=|core\.gitproxy=|credential\.|alias\.|core\.pager=|core\.editor=|core\.askpass=|merge\.[^=]*\.driver=|url\.)' || true
}
bad_config="$(config_refused rootgit)"
if [[ -z "$bad_config" && -f "$root_tmp/scaffold-index" ]]; then bad_config="$(config_refused rootgit_scaffold ../../../scaffold)"; fi
if [[ -n "$bad_config" ]]; then
  echo "vps-deploy: the repository configuration sets keys root must not honour — refusing to deploy:" >&2
  printf '  %s\n' "$bad_config" >&2
  exit 1
fi
for attr in /opt/deploy/.git/info/attributes "$scaffold_gitdir/info/attributes"; do
  if [[ -e "$attr" ]]; then
    echo "vps-deploy: $attr exists; attributes outside the tracked tree could select a filter — refusing to deploy." >&2
    exit 1
  fi
done

# What root executes below must be exactly the commit at HEAD, on the deployed
# branch. The deploy user owns this checkout, so an edited hook, compose file
# or Caddy snippet that never went through git would otherwise run as root on
# the next deploy, whatever the signature gate says about HEAD. Refuse:
#   * any modified, staged or deleted tracked file (a dirty scaffold submodule
#     shows here too);
#   * a checkout that is not the deployed branch tracking origin;
#   * an untracked app hook (the loop below would execute it) or a compose
#     override file (compose would merge it silently).
# Other untracked files (an operator's .bak copy of an env file, local notes)
# are harmless and stay allowed, so a routine deploy is not blocked by them.
branch="$(runuser -u {{ deploy_user }} -- git rev-parse --abbrev-ref HEAD)"
upstream="$(runuser -u {{ deploy_user }} -- git rev-parse --abbrev-ref '@{u}' 2>/dev/null || echo none)"
if [[ "$branch" != "{{ deploy_branch }}" || "$upstream" != "origin/{{ deploy_branch }}" ]]; then
  echo "vps-deploy: checkout is on '$branch' tracking '$upstream', expected '{{ deploy_branch }}' tracking 'origin/{{ deploy_branch }}' — refusing to deploy." >&2
  exit 1
fi
# HEAD must be the tip just fetched, not an older commit that happens to carry
# a good signature (a checkout rewound by hand would otherwise deploy a known-
# faulty version with every gate passing).
remote_head="$(runuser -u {{ deploy_user }} -- git rev-parse 'origin/{{ deploy_branch }}')"
if [[ "$new_head" != "$remote_head" ]]; then
  echo "vps-deploy: HEAD $new_head is not origin/{{ deploy_branch }} ($remote_head) — refusing to deploy." >&2
  exit 1
fi
# The working tree must equal HEAD: compared as root, against the private
# index copy (refreshed first so a touched-but-identical file does not count),
# with submodule changes included. Untracked files are not consulted here;
# the hook and override checks below cover the untracked paths that matter.
rootgit update-index -q --refresh >/dev/null 2>&1 || true
dirty="$(rootgit diff-index --name-status HEAD -- || true)"
if [[ -n "$dirty" ]]; then
  echo "vps-deploy: working tree differs from HEAD — refusing to deploy. Changes must arrive through git:" >&2
  printf '  %s\n' "$dirty" >&2
  exit 1
fi
# The scaffold submodule is executed too (compose base, run-caddy.sh, hooks'
# helpers): its checked-out commit must be the one HEAD records, and its own
# working tree must be clean.
if [[ -f "$root_tmp/scaffold-index" ]]; then
  recorded="$(rootgit rev-parse HEAD:scaffold)"
  actual="$(rootgit_scaffold rev-parse HEAD)"
  if [[ "$recorded" != "$actual" ]]; then
    echo "vps-deploy: scaffold is checked out at $actual but HEAD records $recorded — refusing to deploy." >&2
    exit 1
  fi
  rootgit_scaffold update-index -q --refresh >/dev/null 2>&1 || true
  scaffold_dirty="$(rootgit_scaffold diff-index --name-status HEAD -- || true)"
  if [[ -n "$scaffold_dirty" ]]; then
    echo "vps-deploy: scaffold working tree differs from its commit — refusing to deploy:" >&2
    printf '  %s\n' "$scaffold_dirty" >&2
    exit 1
  fi
fi
# The index copy must be an honest one: a skip-worktree or assume-unchanged bit
# would hide an edited tracked file from the comparison above. Accept only
# plain tracked entries ("H").
flagged="$(rootgit ls-files -v | grep -v '^H ' || true)"
if [[ -n "$flagged" ]]; then
  echo "vps-deploy: index entries carry non-default flags (skip-worktree/assume-unchanged); the clean-tree check cannot be trusted — refusing to deploy:" >&2
  printf '  %s\n' "$flagged" >&2
  exit 1
fi
# Compose reads COMPOSE_FILE, COMPOSE_PROFILES and friends from the project's
# .env, which the deploy user writes. Any of them would steer the root-run
# `docker compose` towards files the checks above never looked at, so the .env
# may hold interpolation values only.
# Compose's dotenv grammar ends a key at '=' or ':' and trims spaces before
# the separator, so the pattern must accept both; DOCKER_* keys steer the
# CLI itself and are refused for the same reason.
if grep -Eq '^[[:space:]]*(export[[:space:]]+)?(COMPOSE|DOCKER)_[A-Za-z0-9_.-]*[[:space:]]*[=:]' .env 2>/dev/null; then
  echo "vps-deploy: .env sets a COMPOSE_* or DOCKER_* variable; compose behaviour must come from the tracked compose files — refusing to deploy." >&2
  exit 1
fi
for f in docker-compose.override.yml docker-compose.override.yaml compose.override.yml compose.override.yaml; do
  if [[ -e "$f" ]]; then
    echo "vps-deploy: $f is present in /opt/deploy — compose would merge it unreviewed; remove it to deploy." >&2
    exit 1
  fi
done
for hook in ./apps/*/deploy.sh; do
  [[ -e "$hook" ]] || continue
  if ! rootgit ls-files --error-unmatch "$hook" >/dev/null 2>&1; then
    echo "vps-deploy: ${hook#./} is not tracked by git — refusing to run an unreviewed hook as root." >&2
    exit 1
  fi
done
{% if deploy_verify_signature | default(false) | bool %}

# Supply-chain gate (deploy_verify_signature): everything below runs as root
# (compose up + app hooks). Refuse to apply a HEAD that is not a good signature
# from a trusted signer — a merge that bypassed review cannot then execute as
# root. Verification runs AS ROOT with root-owned configuration only: the
# allowed-signers file under /etc/ssh and the keyring under /etc/vps-scaffold.
# The deploy user's own git config and keyring are deliberately not consulted
# (GIT_CONFIG_NOSYSTEM, an empty global config, a fixed GNUPGHOME), so the
# trust store really is outside the deploy account's reach. safe.directory is
# needed because root is reading a checkout owned by another user.
# The repository-local .git/config is ALSO deploy-owned and is still read, and
# it can name the programs git runs to verify a signature (gpg.program,
# gpg.ssh.program) and the hooks path. Pin every program-selecting key on the
# command line, which outranks any config file, so the only code root runs
# here is the system gpg and ssh-keygen.
if ! env -i PATH="$PATH" HOME=/root GNUPGHOME=/etc/vps-scaffold/gnupg \
       GIT_CONFIG_NOSYSTEM=1 GIT_CONFIG_GLOBAL=/dev/null GIT_NO_REPLACE_OBJECTS=1 GIT_OPTIONAL_LOCKS=0 \
     git -C /opt/deploy -c safe.directory=/opt/deploy \
       -c gpg.program=/usr/bin/gpg -c gpg.openpgp.program=/usr/bin/gpg \
       -c gpg.ssh.program=/usr/bin/ssh-keygen -c gpg.x509.program=/usr/bin/gpgsm \
       -c core.hooksPath=/dev/null -c core.fsmonitor=false \
       -c gpg.ssh.allowedSignersFile=/etc/ssh/allowed_signers \
       verify-commit HEAD; then
  echo "vps-deploy: HEAD is not a verified signed commit — refusing to deploy." >&2
  exit 1
fi
{% endif %}

rewind_guard "$new_head"

# Secrets (docs/13-secrets.md): decrypt the repo's secrets/ into the .env files
# Compose reads, after the signed-commit check so that only reviewed
# ciphertext is ever decrypted, and before anything starts. Every file must be
# tracked, as the hooks above must be: an untracked file is not part of the
# reviewed commit. vps-secrets-render writes nothing unless every file
# decrypts, and leaves unchanged files untouched. No secrets/ directory, no
# effect. When the repo carries the backup set under secrets/backup/, the
# renderer also installs it into /etc/restic (root-only) and removes a service
# file the repo no longer names, so the reviewed commit is the only source of
# the restic configuration (docs/13-secrets.md, Decision 2).
if [[ -d secrets ]]; then
  while IFS= read -r -d '' f; do
    if ! rootgit --literal-pathspecs ls-files --error-unmatch -- "$f" >/dev/null 2>&1; then
      echo "vps-deploy: ${f#./} is not tracked by git — refusing to decrypt an unreviewed secrets file." >&2
      exit 1
    fi
    # A whole file (docs/13 "Whole files") is rendered to its mirrored path.
    # That path must not be a tracked file: the render would replace the
    # reviewed content with content no reviewer could read.
    case "$f" in
      ./secrets/recovery.sops|*.env.sops) ;;
      *.sops)
        target="${f#./secrets/}"; target="${target%.sops}"
        if rootgit --literal-pathspecs ls-files --error-unmatch -- "$target" >/dev/null 2>&1; then
          echo "vps-deploy: ${f#./} would be rendered over $target, which git tracks — a rendered file never replaces a reviewed one; refusing to deploy." >&2
          exit 1
        fi ;;
    esac
  done < <(find ./secrets -type f -print0)
  /usr/local/sbin/vps-secrets-render --repo /opt/deploy --restic-dir /etc/restic
fi

docker compose pull --policy always

# Keep server and app env files locked down. Only chmod files that are not
# already 600 — an unconditional chmod bumps ctime on every deploy and trips
# the AIDE tripwire on the deployed tree for no real change. Both passes run
# AS THE DEPLOY ACCOUNT: every file they are meant to touch is that account's,
# and chmod follows symlinks, so running them as root inside a tree that
# account writes would let a planted link change the mode of a file outside
# it (2026-11-03 review). A file the deploy account cannot change is reported
# and left alone.
runuser -u {{ deploy_user }} -- find . \
  \( -path './.env' -o -path './apps/*/.env' -o -path './apps/*/*/.env' -o -path './backup/config.env' -o -path './backup/services/*.env' \) \
  -type f ! -perm 600 -exec chmod 600 {} + \
  || echo "vps-deploy: not every env file could be locked to 600 (a file not owned by {{ deploy_user }}?)" >&2

# The inverse pass: containers run as dedicated non-root uids and bind-mount
# repo files (compose configs, Caddy snippets, app config like sites.yaml).
# Files created under the deploy user's hardened umask (e.g. before this
# wrapper's umask 022 applied, or by hand) can lack the world-readable bit,
# making them unreadable inside any container whose uid is not the deploy
# user's — readability must not depend on that coincidence. Normalise the
# container-consumed tree to world-readable, conditionally for the same
# ctime/AIDE reason as above. Secrets are exactly the .env set locked to 600
# above and the whole files rendered from secrets/ (docs/13 "Whole files",
# named after their secrets file without ".sops"), and are excluded here.
rendered_prune=()
if [[ -d secrets ]]; then
  while IFS= read -r -d '' f; do
    rendered_prune+=(-o -path "./${f#./secrets/}")
  done < <(find ./secrets -type f -name '*.sops' ! -name '*.env.sops' ! -path './secrets/recovery.sops' -print0 | sed -z 's/\.sops$//')
fi
runuser -u {{ deploy_user }} -- find ./apps ./scaffold ./.generated ./Caddyfile \
  \( -name '.env' -o -name '.env.*' "${rendered_prune[@]}" \) -prune \
  -o -type f ! -perm -0004 -exec chmod o+r {} + \
  -o -type d ! -perm -0005 -exec chmod o+rx {} + \
  || echo "vps-deploy: not every container-read file could be made world-readable (a file not owned by {{ deploy_user }}?)" >&2

{% endif %}

{% if deploy_release_tree | default(false) | bool %}
# Whether a hook ran decides what a failed acceptance probe may do later: a
# hook may have migrated data the previous release cannot read, so a deploy
# that ran one is never rolled back automatically (docs/15).
hooks_ran=0
{% endif %}
for hook in ./apps/*/deploy.sh; do
  if [[ -x "$hook" ]]; then
    echo "Running app deploy hook: ${hook#./}"
    "$hook" 9>&-
{% if deploy_release_tree | default(false) | bool %}
    hooks_ran=1
{% endif %}
  fi
done

# Recreate only what changed. Compose recreates a container by itself when
# its image, its compose definition or its environment (env_file contents
# included) differ from the running one, so a deploy need not recreate the
# whole stack: doing so put every app's start-up on the one vCPU at once, and
# a slow starter then missed its health deadline with nothing actually wrong
# (prod-rch-vps, 2026-11-02, twice). What compose cannot see is a change to a
# file bind-mounted from the repo (a Caddy bundle, sites.yaml, custom terms):
# those services are recreated explicitly, chosen from the paths this deploy
# changed and each service's bind mounts in the resolved config.
# The selection and the compose up are functions of the two commits, so that
# an automatic rollback (below) can bring the previous release up the same
# way, from its own directory.
# changed_paths OLD NEW prints the repo-relative paths that differ between two
# commits, one per line. Kept as a function so another deploy mode (a release
# tree without a checkout) can supply its own source for the same answer.
{% if deploy_release_tree | default(false) | bool %}
# Release tree: there is no checkout; root's mirror holds both commits.
changed_paths() {
  env -i PATH="$PATH" HOME=/root GIT_CONFIG_NOSYSTEM=1 GIT_CONFIG_GLOBAL=/dev/null GIT_NO_REPLACE_OBJECTS=1 \
    git --git-dir=/var/lib/vps-deploy/repo.git -c core.hooksPath=/dev/null \
    diff --name-only "$1" "$2" -- 2>/dev/null || true
}
{% else %}
changed_paths() {
  rootgit diff --name-only "$1" "$2" -- 2>/dev/null || true
}
{% endif %}
# services_with_changed_mounts OLD NEW OLD_SCAFFOLD NEW_SCAFFOLD prints, one
# per line and once each, the services of the stack in the cwd that bind-mount
# a path the two commits differ in.
services_with_changed_mounts() {
  local changed
  changed="$(changed_paths "$1" "$2")"
  if [[ "$3" != "$4" ]]; then
    changed="${changed}"$'\n'"scaffold"
  fi
  # A changed secrets file is rendered to its mirrored path (docs/13), which a
  # service may bind-mount (a whole file such as a signing key): count the
  # rendered path as changed too, so that service is recreated.
  changed="${changed}"$'\n'"$(printf '%s\n' "$changed" | sed -n 's#^secrets/\(.*\)\.sops$#\1#p')"
  [[ -n "${changed//[[:space:]]/}" ]] || return 0
  local svc rel path
  while IFS=$'\t' read -r svc rel; do
    [[ -n "$svc" ]] || continue
    while IFS= read -r path; do
      [[ -n "$path" ]] || continue
      if [[ "$path" == "$rel" || "$path" == "$rel"/* || "$rel" == "$path"/* ]]; then
        echo "$svc"
        break
      fi
    done <<< "$changed"
  # Bind sources are read from the stack's own directory (the cwd), as compose
  # resolved them, never from a repository path.
  done < <(docker compose config --format json 2>/dev/null | python3 -c '
import json, os, sys
# Under the release tree /opt/deploy is a link: compose may report sources
# under the link (PWD) or under the release it points at (getcwd).
roots = {p.rstrip("/") + "/" for p in (os.getcwd(), os.environ.get("PWD", "")) if p}
cfg = json.load(sys.stdin)
for name, svc in sorted(cfg.get("services", {}).items()):
    for vol in svc.get("volumes", []) or []:
        src = vol.get("source", "") if isinstance(vol, dict) else ""
        for root in roots:
            if vol.get("type") == "bind" and src.startswith(root):
                print(name + "\t" + src[len(root):].rstrip("/"))
                break
') | sort -u
}

# A network whose definition changed (internal, driver, IPv6) is removed and
# created again by compose, which then only reconnects the containers already
# on it, and a reconnected container loses its service-name alias: on MCH on
# 2026-11-04, planka-db answered only to its container name after its network
# became internal, and Planka could not find its database. Find such networks
# before the compose up, while the old ones still exist, and recreate every
# service on them in a compose up of their own, before the main one.
# services_on_changed_networks prints those services, one per line.
services_on_changed_networks() {
  docker compose config --format json 2>/dev/null | python3 -c '
import json, subprocess, sys
cfg = json.load(sys.stdin)
changed = set()
for key, net in (cfg.get("networks") or {}).items():
    net = net or {}
    if net.get("external"):
        continue
    name = net.get("name") or key
    r = subprocess.run(["docker", "network", "inspect", name, "--format",
                        "{% raw %}{{json .}}{% endraw %}"], capture_output=True, text=True)
    if r.returncode != 0:
        continue  # not created yet: compose creates it and attaches with aliases
    live = json.loads(r.stdout)
    want = (bool(net.get("internal", False)), net.get("driver") or "bridge",
            bool(net.get("enable_ipv6", False)))
    have = (bool(live.get("Internal")), live.get("Driver") or "bridge",
            bool(live.get("EnableIPv6")))
    if want != have:
        changed.add(key)
for svc_name, svc in sorted((cfg.get("services") or {}).items()):
    if changed & set((svc.get("networks") or {}).keys()):
        print(svc_name)
' || true
}
# One retry covers a transient engine hiccup (a container that failed to start
# right after a dockerd/containerd restart). If it still fails, say exactly
# which containers are not Up before returning non-zero — `docker ps` without
# -a hides a container stuck in Created, which is how the 2026-09-05 outage
# went unnoticed for its first hour.
compose_up() {
  if ! docker compose up -d --remove-orphans --wait "$@"; then
    echo "vps-deploy: compose up --wait failed; retrying once in 30 s…" >&2
    sleep 30
    if ! docker compose up -d --remove-orphans --wait "$@"; then
      echo "vps-deploy: compose up --wait failed again. Containers not Up:" >&2
      # A one-shot init container that has exited cleanly is not a failure.
      docker ps -a --format '  {% raw %}{{.Names}}: {{.Status}}{% endraw %}' | grep -vE ': (Up |Exited \(0\))' >&2 || true
      return 1
    fi
  fi
}
# bring_up OLD NEW OLD_SCAFFOLD NEW_SCAFFOLD brings the stack in the cwd up
# for the move from the first commit to the second: the services on changed
# networks first, then the stack, then the services whose mounted files
# changed. Returns non-zero when a compose up failed twice.
bring_up() {
  local netrecreate recreate
  mapfile -t netrecreate < <(services_on_changed_networks)
  mapfile -t recreate < <(services_with_changed_mounts "$1" "$2" "$3" "$4")
  # (Not an array length test: that would open a Jinja comment in this template.)
  if [[ -n "${netrecreate[*]:-}" ]]; then
    echo "vps-deploy: recreating services on networks whose definition changed: ${netrecreate[*]}"
    compose_up --force-recreate "${netrecreate[@]}" || return 1
  fi
{% if deploy_release_tree | default(false) | bool %}
  # The first deploy from a release replaces a checkout: recreate everything
  # once, so no container keeps a mount opened in the old checkout.
  if [[ "$1" == none ]]; then
    compose_up --force-recreate || return 1
  else
    compose_up || return 1
  fi
{% else %}
  compose_up || return 1
{% endif %}
  if [[ -n "${recreate[*]:-}" ]]; then
    echo "vps-deploy: recreating services whose mounted files changed: ${recreate[*]}"
    compose_up --force-recreate "${recreate[@]}" || return 1
  fi
}
bring_up "$old_head" "$new_head" "$old_scaffold" "$new_scaffold" || exit 1

record_deployed "$new_head"

# Acceptance probes. compose --wait says the containers are healthy; it does
# not say that each site answers through Caddy as its access rules declare.
# vps-deploy-probes asks the local Caddy for the root of every site in the
# rendered access table (.generated/caddy/route-access.tsv): a gated site
# must send 302 to the gateway, with and without a forged identity header, a
# public site must answer 2xx or 3xx, and nothing may answer 5xx or not at
# all. A failure is reported and notified, and the wrapper exits non-zero at
# the end so auto-deploy records it. What happens to the deploy depends on
# the layout (docs/05 "Acceptance probes", docs/15 "Automatic rollback").
probe_rc=0
{% if deploy_release_tree | default(false) | bool %}
# Under the release tree the previous release is still on disk, so a deploy
# that failed its probes can be undone here, the way --rollback would, when
# it is safe and wanted: this run must not itself be a rollback, automatic
# rollback must be on for this server (PROBE_ROLLBACK in release.env, from
# deploy_probe_rollback), no app hook may have run (a migration may have
# changed data the previous release cannot read), and there must be an
# earlier release. Otherwise the deploy stays live and the alert says why.
probe_rollback="$(sed -n 's/^PROBE_ROLLBACK=//p' /etc/vps-scaffold/release.env 2>/dev/null | tail -n1)"
previous_release="" rollback_head="" rollback_scaffold="" rolled_back=0
# A failed lookup counts as no earlier release: the deploy is live by now,
# and the conservative answer is to leave it so and alert.
if [[ "$action" != rollback ]]; then
  previous_release="$(/usr/local/sbin/vps-release previous || true)"
fi
if [[ -n "$previous_release" ]]; then
  rollback_head="$(release_field "$previous_release" commit)"
  rollback_scaffold="$(release_field "$previous_release" scaffold)"
fi
probe_outcome=""
if [[ "$action" == rollback ]]; then
  probe_outcome="The release is live and has not been rolled back again, because this deploy was itself a rollback."
elif [[ "${probe_rollback:-1}" != 1 ]]; then
  probe_outcome="The deploy is live and has not been rolled back, because automatic rollback is switched off on this server (deploy_probe_rollback: false). An administrator can roll back by hand with sudo vps-deploy --rollback, or fix forward."
elif [[ "$hooks_ran" == 1 ]]; then
  probe_outcome="The deploy is live and has not been rolled back, because an app deploy hook ran in this deploy and a migration may have changed data that the previous release cannot read. Check the app before choosing between sudo vps-deploy --rollback and a fix forward."
elif [[ -z "$previous_release" ]]; then
  probe_outcome="The deploy is live and has not been rolled back, because there is no earlier release to roll back to."
# A kept release is verified again before it is used: a signer may have been
# removed since it was deployed.
elif ! /usr/local/sbin/vps-release recheck "$previous_release"; then
  probe_outcome="The deploy is live and has not been rolled back, because the previous release ${rollback_head:0:7} no longer verifies against the root-owned trust stores."
fi
if [[ -n "$probe_outcome" ]]; then
  VPS_DEPLOY_PROBES_OUTCOME="$probe_outcome" /usr/local/sbin/vps-deploy-probes /opt/deploy || probe_rc=$?
else
  # The probes stay quiet and leave the failing hosts in a root-owned file;
  # the one alert is sent below, once the outcome is known.
  probe_failed_file="$(mktemp /run/vps-deploy.probes.XXXXXX)"
  trap 'rm -f "$probe_failed_file"' EXIT
  VPS_DEPLOY_PROBES_NOTIFY="" VPS_DEPLOY_PROBES_FAILED_FILE="$probe_failed_file" \
    /usr/local/sbin/vps-deploy-probes /opt/deploy || probe_rc=$?
  if [[ "$probe_rc" -ne 0 ]]; then
    failed_hosts="$(cat "$probe_failed_file" 2>/dev/null || true)"
    [[ -n "$failed_hosts" ]] || failed_hosts="(the probes did not run to the end; the deploy log has the detail)"
    echo "vps-deploy: the probes failed and no app hook ran; rolling back to the previous release ${rollback_head:0:7}." >&2
    # The same steps as --rollback: the link is switched, the commit rolled
    # back from is held so auto-deploy does not bring it straight back, and
    # the previous release is brought up from its own directory. Its images
    # are still on the host, because the prune has not run yet. No rewind
    # guard here: the guard accepts a rollback, and this one goes to the
    # release the guard's own record named before this run.
    /usr/local/sbin/vps-release switch "$previous_release"
    /usr/local/sbin/vps-release hold "$new_head"
    cd /opt/deploy
    if bring_up "$new_head" "$rollback_head" "$new_scaffold" "$rollback_scaffold"; then
      record_deployed "$rollback_head"
      rolled_back=1
      # The live scaffold is the previous release's again, so no host play
      # is due on account of this deploy.
      new_scaffold="$rollback_scaffold"
      rollback_probe_rc=0
      VPS_DEPLOY_PROBES_NOTIFY="" /usr/local/sbin/vps-deploy-probes /opt/deploy || rollback_probe_rc=$?
      if [[ "$rollback_probe_rc" -eq 0 ]]; then
        rollback_result="The previous release ${rollback_head:0:7} is live again and its probes passed."
      else
        rollback_result="The previous release ${rollback_head:0:7} is live again, but its probes failed as well, so the cause is probably outside the two commits (Caddy, DNS or the host); the deploy log has each answer."
      fi
      /usr/local/bin/vps-notify "Deploy probes failed: rolled back to ${rollback_head:0:7}" \
"After compose up reported the containers healthy, these sites did not answer as their access rules declare:
$failed_hosts

${new_head:0:7} ran no app deploy hook, so vps-deploy switched /opt/deploy back to ${rollback_head:0:7} and brought it up again. $rollback_result

Automatic deploys skip ${new_head:0:7} until a new commit reaches the branch. To deploy ${new_head:0:7} again without a new commit, once the cause is fixed outside the repo, run sudo vps-release unhold." \
        high warning || true
    else
      /usr/local/bin/vps-notify "Deploy probes failed and the rollback did not come up" \
"After compose up reported the containers healthy, these sites did not answer as their access rules declare:
$failed_hosts

${new_head:0:7} ran no app deploy hook, so vps-deploy switched /opt/deploy back to ${rollback_head:0:7}, but compose up did not bring that release up (the deploy log names the containers that are not running). Check the stack with sudo docker ps -a. Automatic deploys skip ${new_head:0:7} until a new commit reaches the branch; sudo vps-release unhold lets them deploy it again." \
        high warning || true
      echo "vps-deploy: the rollback to ${rollback_head:0:7} did not come up." >&2
      exit 1
    fi
  fi
fi
{% else %}
VPS_DEPLOY_PROBES_OUTCOME="The deploy is live and has not been rolled back: this server deploys from a checkout, and automatic rollback needs the release tree (scaffold/docs/15-release-tree.md)." \
  /usr/local/sbin/vps-deploy-probes /opt/deploy || probe_rc=$?
{% endif %}

# Every digest bump strands the superseded image (untagged, unreferenced), and
# nothing else on the host reclaims them — left alone they fill the disk at
# roughly the pace Renovate merges. Prune only after --wait has confirmed the
# new containers healthy; anything removed is pinned in git and re-pullable
# from the registry, so rollback is a re-pull, not a loss. Images (not
# volumes) only, and non-fatal: the deploy itself has already succeeded, and
# a failed prune costs disk, not availability.
docker image prune -af || true
{% if deploy_release_tree | default(false) | bool %}
/usr/local/sbin/vps-release prune || true
if [[ "$action" == rollback ]]; then
  /usr/local/bin/vps-notify "Rolled back to ${new_head:0:7}" \
"vps-deploy --rollback switched /opt/deploy from ${old_head:0:7} to ${new_head:0:7} and redeployed it. Auto-deploy skips ${old_head:0:7} until a new commit reaches the branch." \
    high warning || true
fi
{% endif %}

{% if not deploy_release_tree | default(false) | bool %}
# The deploy changed /opt/deploy's working tree (AIDE-monitored): acknowledge
# via the evidence-recording re-baseline, debounced so back-to-back deploys
# rebaseline once. Deploys are a trusted change channel (CI-gated, signed
# HEAD, announced via ntfy); tampering outside a deploy still alerts. Guarded:
# not every host runs the baseline-hardening AIDE stack. Under the release
# tree AIDE does not watch the releases; vps-release verify checks them.
if [[ "$old_head" != "$new_head" ]]; then
  systemctl restart aide-rebaseline-after-deploy.timer >/dev/null 2>&1 || true
fi
{% endif %}

# A deploy only ships containers. When it moved the scaffold pointer, the
# host layer (roles, timers, scripts) is now behind until someone runs a site
# play -- say so once, here, and let scaffold-drift.timer keep nagging weekly.
# /var/lib/vps-site-applied is written by the site plays' post_tasks.
if [[ "$old_scaffold" != "$new_scaffold" ]]; then
  applied="$(cat /var/lib/vps-site-applied 2>/dev/null || echo none)"
  if [[ "$applied" != "$new_scaffold" ]]; then
    /usr/local/bin/vps-notify "Host play due: scaffold moved to ${new_scaffold:0:7}" \
"This deploy pulled scaffold ${old_scaffold:0:7} -> ${new_scaffold:0:7}; the last site play applied ${applied:0:7}.
Roles, timers and scripts only change on a play: run site-quick.yml (scaffold/docs/12-applying-scaffold-updates.md).
scaffold-drift.timer reminds weekly until they match." \
      default package || true
  fi
fi

# The probes ran above; the housekeeping and notices since then were still
# due, so the failure is reported last, as the exit status.
if [[ "$probe_rc" -ne 0 ]]; then
  if [[ "${rolled_back:-0}" == 1 ]]; then
    echo "vps-deploy: the post-deploy probes failed and the previous release is live again (see above)." >&2
  else
    echo "vps-deploy: the deploy is live, but the post-deploy probes failed (see above)." >&2
  fi
  exit "$probe_rc"
fi
