#!/bin/bash
# vps-deploy — root-owned deploy entrypoint (managed by Ansible, deploy-user role).
#
# In restricted mode this is the ONLY supported way for the deploy user to
# trigger app-level container operations: sudoers allowlists exactly this
# path, the working directory is fixed, and the environment is reset. The
# deploy user's ~/deploy helper calls `sudo vps-deploy`.
#
# Privilege split inside the run: git operates AS the deploy user (repo
# ownership stays intact); docker/compose, env-permission normalisation and
# app hooks run as root.
set -euo pipefail
export PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
umask 022

cd /opt/deploy

# Never deploy while apt is mid-flight. On prod-rch-vps (2026-09-05) an
# auto-deploy started during a docker-ce/containerd upgrade: containerd refused
# the freshly created Authelia container ("failed to start shim") and it sat
# in Created for 2.5 h while everything else stayed up under live-restore.
# Wait (up to 30 min) for unattended-upgrades to finish and the dpkg lock to
# clear before touching the stack.
# NOTE: unattended-upgrades.service is NOT a signal -- it is a boot-time
# RemainAfterExit unit (its job is to block shutdown mid-upgrade) and reads
# "active" all day, which made every deploy sit out the full 30 min. Only the
# apt-daily oneshots, a live unattended-upgrade process, or a held dpkg lock
# mean apt is actually working.
# backup.service dumps every database; recreating a DB container under it
# fails the dump (roster-insights, 2026-09-06 04:08 UTC). Wait for that too.
apt_busy() {
  for u in apt-daily.service apt-daily-upgrade.service backup.service backup-verify.service; do
    case "$(systemctl show -p ActiveState --value "$u" 2>/dev/null)" in
      active|activating|deactivating) return 0 ;;
    esac
  done
  pgrep -f '^/usr/bin/python3 /usr/bin/unattended-upgrade' >/dev/null 2>&1 && return 0
  command -v fuser >/dev/null 2>&1 && fuser /var/lib/dpkg/lock-frontend >/dev/null 2>&1 && return 0
  return 1
}
apt_wait_deadline=$(( $(date +%s) + 1800 ))
while apt_busy; do
  if [[ $(date +%s) -ge $apt_wait_deadline ]]; then
    echo "vps-deploy: apt still busy after 30 min — proceeding anyway." >&2
    break
  fi
  echo "vps-deploy: apt or backup in progress; waiting…"
  sleep 20
done

# Update the repo as the unprivileged owner, never as root. HEAD is captured
# either side of the pull: a moved HEAD means the AIDE-monitored working tree
# legitimately changed, which the tail of this script acknowledges.
old_head="$(runuser -u {{ deploy_user }} -- git rev-parse HEAD)"
old_scaffold="$(runuser -u {{ deploy_user }} -- git -C scaffold rev-parse HEAD 2>/dev/null || echo none)"
runuser -u {{ deploy_user }} -- git pull --recurse-submodules
new_head="$(runuser -u {{ deploy_user }} -- git rev-parse HEAD)"
new_scaffold="$(runuser -u {{ deploy_user }} -- git -C scaffold rev-parse HEAD 2>/dev/null || echo none)"
{% if deploy_verify_signature | default(false) %}

# Supply-chain gate (deploy_verify_signature): everything below runs as root
# (compose up + app hooks). Refuse to apply a HEAD that is not a good signature
# from a signer the deploy user trusts — a merge that bypassed review cannot
# then execute as root. Requires signed commits + a configured
# allowed-signers/keyring for {{ deploy_user }} (docs/05-access-model.md).
if ! runuser -u {{ deploy_user }} -- git -C /opt/deploy verify-commit HEAD; then
  echo "vps-deploy: HEAD is not a verified signed commit — refusing to deploy." >&2
  exit 1
fi
{% endif %}

docker compose pull --policy always

# Keep server and app env files locked down. Only chmod files that are not
# already 600 — an unconditional chmod bumps ctime on every deploy and trips
# the AIDE tripwire on the deployed tree for no real change.
find . \
  \( -path './.env' -o -path './apps/*/.env' -o -path './backup/config.env' -o -path './backup/services/*.env' \) \
  -type f ! -perm 600 -exec chmod 600 {} +

# The inverse pass: containers run as dedicated non-root uids and bind-mount
# repo files (compose configs, Caddy snippets, app config like sites.yaml).
# Files created under the deploy user's hardened umask (e.g. before this
# wrapper's umask 022 applied, or by hand) can lack the world-readable bit,
# making them unreadable inside any container whose uid is not the deploy
# user's — readability must not depend on that coincidence. Normalise the
# container-consumed tree to world-readable, conditionally for the same
# ctime/AIDE reason as above. Secrets are exactly the .env set locked to 600
# above and are excluded here.
find ./apps ./scaffold ./.generated ./Caddyfile \
  \( -name '.env' -o -name '.env.*' \) -prune \
  -o -type f ! -perm -0004 -exec chmod o+r {} + \
  -o -type d ! -perm -0005 -exec chmod o+rx {} +

for hook in ./apps/*/deploy.sh; do
  if [[ -x "$hook" ]]; then
    echo "Running app deploy hook: ${hook#./}"
    "$hook"
  fi
done

# One retry covers a transient engine hiccup (a container that failed to start
# right after a dockerd/containerd restart). If it still fails, say exactly
# which containers are not Up before exiting non-zero — `docker ps` without -a
# hides a container stuck in Created, which is how the 2026-09-05 outage went
# unnoticed for its first hour.
if ! docker compose up -d --remove-orphans --wait --force-recreate; then
  echo "vps-deploy: compose up --wait failed; retrying once in 30 s…" >&2
  sleep 30
  if ! docker compose up -d --remove-orphans --wait; then
    echo "vps-deploy: compose up --wait failed again. Containers not Up:" >&2
    docker ps -a --format '  {% raw %}{{.Names}}: {{.Status}}{% endraw %}' | grep -vE ': Up ' >&2 || true
    exit 1
  fi
fi

# Every digest bump strands the superseded image (untagged, unreferenced), and
# nothing else on the host reclaims them — left alone they fill the disk at
# roughly the pace Renovate merges. Prune only after --wait has confirmed the
# new containers healthy; anything removed is pinned in git and re-pullable
# from the registry, so rollback is a re-pull, not a loss. Images (not
# volumes) only, and non-fatal: the deploy itself has already succeeded, and
# a failed prune costs disk, not availability.
docker image prune -af || true

# The deploy changed /opt/deploy's working tree (AIDE-monitored): acknowledge
# via the evidence-recording re-baseline, debounced so back-to-back deploys
# rebaseline once. Deploys are a trusted change channel (CI-gated, signed
# HEAD, announced via ntfy); tampering outside a deploy still alerts. Guarded:
# not every host runs the baseline-hardening AIDE stack.
if [[ "$old_head" != "$new_head" ]]; then
  systemctl restart aide-rebaseline-after-deploy.timer >/dev/null 2>&1 || true
fi

# A deploy only ships containers. When it moved the scaffold pointer, the
# host layer (roles, timers, scripts) is now behind until someone runs a site
# play -- say so once, here, and let scaffold-drift.timer keep nagging weekly.
# /var/lib/vps-site-applied is written by the site plays' post_tasks.
if [[ "$old_scaffold" != "$new_scaffold" ]]; then
  applied="$(cat /var/lib/vps-site-applied 2>/dev/null || echo none)"
  if [[ "$applied" != "$new_scaffold" ]]; then
    /usr/local/bin/vps-notify "Host play due: scaffold moved to ${new_scaffold:0:7}" \
"This deploy pulled scaffold ${old_scaffold:0:7} -> ${new_scaffold:0:7}; the last site play applied ${applied:0:7}.
Roles, timers and scripts only change on a play: run site-quick.yml (scaffold/docs/04-server-repo.md).
scaffold-drift.timer reminds weekly until they match." \
      default package || true
  fi
fi
