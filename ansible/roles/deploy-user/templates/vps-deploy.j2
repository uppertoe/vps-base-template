#!/bin/bash
# vps-deploy — root-owned deploy entrypoint (managed by Ansible, deploy-user role).
#
# In restricted mode this is the ONLY supported way for the deploy user to
# trigger app-level container operations: sudoers allowlists exactly this
# path, the working directory is fixed, and the environment is reset. The
# deploy user's ~/deploy helper calls `sudo vps-deploy`.
#
# Privilege split inside the run: git operates AS the deploy user (repo
# ownership stays intact); docker/compose, env-permission normalisation and
# app hooks run as root.
set -euo pipefail
export PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
umask 022

cd /opt/deploy

# Hand back anything under .git that a hand-run root git has taken (a root-owned
# index stops the deploy account's pull). Logged and announced by the helper.
/usr/local/sbin/vps-git-heal || true

# Never deploy while apt is mid-flight. On prod-rch-vps (2026-09-05) an
# auto-deploy started during a docker-ce/containerd upgrade: containerd refused
# the freshly created Authelia container ("failed to start shim") and it sat
# in Created for 2.5 h while everything else stayed up under live-restore.
# Wait (up to 30 min) for unattended-upgrades to finish and the dpkg lock to
# clear before touching the stack.
# NOTE: unattended-upgrades.service is NOT a signal -- it is a boot-time
# RemainAfterExit unit (its job is to block shutdown mid-upgrade) and reads
# "active" all day, which made every deploy sit out the full 30 min. Only the
# apt-daily oneshots, a live unattended-upgrade process, or a held dpkg lock
# mean apt is actually working.
# backup.service dumps every database; recreating a DB container under it
# fails the dump (roster-insights, 2026-09-06 04:08 UTC). Wait for that too.
apt_busy() {
  for u in apt-daily.service apt-daily-upgrade.service backup.service backup-verify.service; do
    case "$(systemctl show -p ActiveState --value "$u" 2>/dev/null)" in
      active|activating|deactivating) return 0 ;;
    esac
  done
  pgrep -f '^/usr/bin/python3 /usr/bin/unattended-upgrade' >/dev/null 2>&1 && return 0
  command -v fuser >/dev/null 2>&1 && fuser /var/lib/dpkg/lock-frontend >/dev/null 2>&1 && return 0
  return 1
}
apt_wait_deadline=$(( $(date +%s) + 1800 ))
while apt_busy; do
  if [[ $(date +%s) -ge $apt_wait_deadline ]]; then
    echo "vps-deploy: apt still busy after 30 min — proceeding anyway." >&2
    break
  fi
  echo "vps-deploy: apt or backup in progress; waiting…"
  sleep 20
done

# Update the repo as the unprivileged owner, never as root. HEAD is captured
# either side of the pull: a moved HEAD means the AIDE-monitored working tree
# legitimately changed, which the tail of this script acknowledges.
# GIT_NO_REPLACE_OBJECTS: a refs/replace entry in the deploy-owned .git would
# otherwise let every git command below (the checks, the signature gate, the
# tree root reads) see a different object than the one at HEAD. Exported so
# both the deploy-user and root invocations ignore replacements.
export GIT_NO_REPLACE_OBJECTS=1
# GIT_OPTIONAL_LOCKS=0: the root-side git reads below must never write the
# deploy-owned index. Without it a status-style refresh can rewrite .git/index
# as root (seen 2026-11-01 after a bind-mounted directory changed owner), and
# the deploy user's next pull fails with "index file open failed".
export GIT_OPTIONAL_LOCKS=0
old_head="$(runuser -u {{ deploy_user }} -- git rev-parse HEAD)"
old_scaffold="$(runuser -u {{ deploy_user }} -- git -C scaffold rev-parse HEAD 2>/dev/null || echo none)"
runuser -u {{ deploy_user }} -- git pull --recurse-submodules
new_head="$(runuser -u {{ deploy_user }} -- git rev-parse HEAD)"
new_scaffold="$(runuser -u {{ deploy_user }} -- git -C scaffold rev-parse HEAD 2>/dev/null || echo none)"

# Root-side git reads. Every check that decides what root is about to execute
# runs as root with an isolated configuration: no system or global config, the
# deploy-owned repository config outranked on the command line for the keys
# that select programs or hide changes, replacement objects ignored, and a
# PRIVATE COPY of the index so the stat refresh the comparison needs is written
# to a root-owned temporary file and never to the deploy-owned index. The
# deploy account's own git configuration therefore cannot change the answer
# (the 2026-11-02 review: fsmonitor and submodule-ignore settings in a config
# that account writes would otherwise have been consulted).
root_tmp="$(mktemp -d /run/vps-deploy.XXXXXX)"
trap 'rm -rf "$root_tmp"' EXIT
cp /opt/deploy/.git/index "$root_tmp/index"
rootgit() {
  env -i PATH="$PATH" HOME=/root GIT_CONFIG_NOSYSTEM=1 GIT_CONFIG_GLOBAL=/dev/null \
      GIT_NO_REPLACE_OBJECTS=1 GIT_OPTIONAL_LOCKS=0 GIT_INDEX_FILE="$root_tmp/index" \
    git -C /opt/deploy -c safe.directory=/opt/deploy -c core.hooksPath=/dev/null \
      -c core.fsmonitor=false -c diff.ignoreSubmodules=none -c submodule.scaffold.ignore=none "$@"
}
# The scaffold submodule has its own index under .git/modules; copy it too.
scaffold_gitdir="$(runuser -u {{ deploy_user }} -- git -C scaffold rev-parse --git-dir 2>/dev/null || true)"
case "$scaffold_gitdir" in
  /*) ;;
  "") ;;
  *) scaffold_gitdir="/opt/deploy/scaffold/$scaffold_gitdir" ;;
esac
if [[ -n "$scaffold_gitdir" && -f "$scaffold_gitdir/index" ]]; then
  cp "$scaffold_gitdir/index" "$root_tmp/scaffold-index"
fi
rootgit_scaffold() {
  env -i PATH="$PATH" HOME=/root GIT_CONFIG_NOSYSTEM=1 GIT_CONFIG_GLOBAL=/dev/null \
      GIT_NO_REPLACE_OBJECTS=1 GIT_OPTIONAL_LOCKS=0 GIT_INDEX_FILE="$root_tmp/scaffold-index" \
    git -C /opt/deploy/scaffold -c safe.directory=/opt/deploy/scaffold -c safe.directory=/opt/deploy \
      -c core.hooksPath=/dev/null -c core.fsmonitor=false "$@"
}

# What root executes below must be exactly the commit at HEAD, on the deployed
# branch. The deploy user owns this checkout, so an edited hook, compose file
# or Caddy snippet that never went through git would otherwise run as root on
# the next deploy, whatever the signature gate says about HEAD. Refuse:
#   * any modified, staged or deleted tracked file (a dirty scaffold submodule
#     shows here too);
#   * a checkout that is not the deployed branch tracking origin;
#   * an untracked app hook (the loop below would execute it) or a compose
#     override file (compose would merge it silently).
# Other untracked files (an operator's .bak copy of an env file, local notes)
# are harmless and stay allowed, so a routine deploy is not blocked by them.
branch="$(runuser -u {{ deploy_user }} -- git rev-parse --abbrev-ref HEAD)"
upstream="$(runuser -u {{ deploy_user }} -- git rev-parse --abbrev-ref '@{u}' 2>/dev/null || echo none)"
if [[ "$branch" != "{{ deploy_branch }}" || "$upstream" != "origin/{{ deploy_branch }}" ]]; then
  echo "vps-deploy: checkout is on '$branch' tracking '$upstream', expected '{{ deploy_branch }}' tracking 'origin/{{ deploy_branch }}' — refusing to deploy." >&2
  exit 1
fi
# HEAD must be the tip just fetched, not an older commit that happens to carry
# a good signature (a checkout rewound by hand would otherwise deploy a known-
# faulty version with every gate passing).
remote_head="$(runuser -u {{ deploy_user }} -- git rev-parse 'origin/{{ deploy_branch }}')"
if [[ "$new_head" != "$remote_head" ]]; then
  echo "vps-deploy: HEAD $new_head is not origin/{{ deploy_branch }} ($remote_head) — refusing to deploy." >&2
  exit 1
fi
# The working tree must equal HEAD: compared as root, against the private
# index copy (refreshed first so a touched-but-identical file does not count),
# with submodule changes included. Untracked files are not consulted here;
# the hook and override checks below cover the untracked paths that matter.
rootgit update-index -q --refresh >/dev/null 2>&1 || true
dirty="$(rootgit diff-index --name-status HEAD -- || true)"
if [[ -n "$dirty" ]]; then
  echo "vps-deploy: working tree differs from HEAD — refusing to deploy. Changes must arrive through git:" >&2
  printf '  %s\n' "$dirty" >&2
  exit 1
fi
# The scaffold submodule is executed too (compose base, run-caddy.sh, hooks'
# helpers): its checked-out commit must be the one HEAD records, and its own
# working tree must be clean.
if [[ -f "$root_tmp/scaffold-index" ]]; then
  recorded="$(rootgit rev-parse HEAD:scaffold)"
  actual="$(rootgit_scaffold rev-parse HEAD)"
  if [[ "$recorded" != "$actual" ]]; then
    echo "vps-deploy: scaffold is checked out at $actual but HEAD records $recorded — refusing to deploy." >&2
    exit 1
  fi
  rootgit_scaffold update-index -q --refresh >/dev/null 2>&1 || true
  scaffold_dirty="$(rootgit_scaffold diff-index --name-status HEAD -- || true)"
  if [[ -n "$scaffold_dirty" ]]; then
    echo "vps-deploy: scaffold working tree differs from its commit — refusing to deploy:" >&2
    printf '  %s\n' "$scaffold_dirty" >&2
    exit 1
  fi
fi
# The index copy must be an honest one: a skip-worktree or assume-unchanged bit
# would hide an edited tracked file from the comparison above. Accept only
# plain tracked entries ("H").
flagged="$(rootgit ls-files -v | grep -v '^H ' || true)"
if [[ -n "$flagged" ]]; then
  echo "vps-deploy: index entries carry non-default flags (skip-worktree/assume-unchanged); the clean-tree check cannot be trusted — refusing to deploy:" >&2
  printf '  %s\n' "$flagged" >&2
  exit 1
fi
# Compose reads COMPOSE_FILE, COMPOSE_PROFILES and friends from the project's
# .env, which the deploy user writes. Any of them would steer the root-run
# `docker compose` towards files the checks above never looked at, so the .env
# may hold interpolation values only.
if grep -Eq '^[[:space:]]*(export[[:space:]]+)?COMPOSE_[A-Z_]*=' .env 2>/dev/null; then
  echo "vps-deploy: .env sets a COMPOSE_* variable; compose behaviour must come from the tracked compose files — refusing to deploy." >&2
  exit 1
fi
for f in docker-compose.override.yml docker-compose.override.yaml compose.override.yml compose.override.yaml; do
  if [[ -e "$f" ]]; then
    echo "vps-deploy: $f is present in /opt/deploy — compose would merge it unreviewed; remove it to deploy." >&2
    exit 1
  fi
done
for hook in ./apps/*/deploy.sh; do
  [[ -e "$hook" ]] || continue
  if ! rootgit ls-files --error-unmatch "$hook" >/dev/null 2>&1; then
    echo "vps-deploy: ${hook#./} is not tracked by git — refusing to run an unreviewed hook as root." >&2
    exit 1
  fi
done
{% if deploy_verify_signature | default(false) %}

# Supply-chain gate (deploy_verify_signature): everything below runs as root
# (compose up + app hooks). Refuse to apply a HEAD that is not a good signature
# from a trusted signer — a merge that bypassed review cannot then execute as
# root. Verification runs AS ROOT with root-owned configuration only: the
# allowed-signers file under /etc/ssh and the keyring under /etc/vps-scaffold.
# The deploy user's own git config and keyring are deliberately not consulted
# (GIT_CONFIG_NOSYSTEM, an empty global config, a fixed GNUPGHOME), so the
# trust store really is outside the deploy account's reach. safe.directory is
# needed because root is reading a checkout owned by another user.
# The repository-local .git/config is ALSO deploy-owned and is still read, and
# it can name the programs git runs to verify a signature (gpg.program,
# gpg.ssh.program) and the hooks path. Pin every program-selecting key on the
# command line, which outranks any config file, so the only code root runs
# here is the system gpg and ssh-keygen.
if ! env -i PATH="$PATH" HOME=/root GNUPGHOME=/etc/vps-scaffold/gnupg \
       GIT_CONFIG_NOSYSTEM=1 GIT_CONFIG_GLOBAL=/dev/null GIT_NO_REPLACE_OBJECTS=1 GIT_OPTIONAL_LOCKS=0 \
     git -C /opt/deploy -c safe.directory=/opt/deploy \
       -c gpg.program=/usr/bin/gpg -c gpg.openpgp.program=/usr/bin/gpg \
       -c gpg.ssh.program=/usr/bin/ssh-keygen -c gpg.x509.program=/usr/bin/gpgsm \
       -c core.hooksPath=/dev/null -c core.fsmonitor=false \
       -c gpg.ssh.allowedSignersFile=/etc/ssh/allowed_signers \
       verify-commit HEAD; then
  echo "vps-deploy: HEAD is not a verified signed commit — refusing to deploy." >&2
  exit 1
fi
{% endif %}

docker compose pull --policy always

# Keep server and app env files locked down. Only chmod files that are not
# already 600 — an unconditional chmod bumps ctime on every deploy and trips
# the AIDE tripwire on the deployed tree for no real change.
find . \
  \( -path './.env' -o -path './apps/*/.env' -o -path './apps/*/*/.env' -o -path './backup/config.env' -o -path './backup/services/*.env' \) \
  -type f ! -perm 600 -exec chmod 600 {} +

# The inverse pass: containers run as dedicated non-root uids and bind-mount
# repo files (compose configs, Caddy snippets, app config like sites.yaml).
# Files created under the deploy user's hardened umask (e.g. before this
# wrapper's umask 022 applied, or by hand) can lack the world-readable bit,
# making them unreadable inside any container whose uid is not the deploy
# user's — readability must not depend on that coincidence. Normalise the
# container-consumed tree to world-readable, conditionally for the same
# ctime/AIDE reason as above. Secrets are exactly the .env set locked to 600
# above and are excluded here.
find ./apps ./scaffold ./.generated ./Caddyfile \
  \( -name '.env' -o -name '.env.*' \) -prune \
  -o -type f ! -perm -0004 -exec chmod o+r {} + \
  -o -type d ! -perm -0005 -exec chmod o+rx {} +

for hook in ./apps/*/deploy.sh; do
  if [[ -x "$hook" ]]; then
    echo "Running app deploy hook: ${hook#./}"
    "$hook"
  fi
done

# One retry covers a transient engine hiccup (a container that failed to start
# right after a dockerd/containerd restart). If it still fails, say exactly
# which containers are not Up before exiting non-zero — `docker ps` without -a
# hides a container stuck in Created, which is how the 2026-09-05 outage went
# unnoticed for its first hour.
if ! docker compose up -d --remove-orphans --wait --force-recreate; then
  echo "vps-deploy: compose up --wait failed; retrying once in 30 s…" >&2
  sleep 30
  if ! docker compose up -d --remove-orphans --wait; then
    echo "vps-deploy: compose up --wait failed again. Containers not Up:" >&2
    docker ps -a --format '  {% raw %}{{.Names}}: {{.Status}}{% endraw %}' | grep -vE ': Up ' >&2 || true
    exit 1
  fi
fi

# Every digest bump strands the superseded image (untagged, unreferenced), and
# nothing else on the host reclaims them — left alone they fill the disk at
# roughly the pace Renovate merges. Prune only after --wait has confirmed the
# new containers healthy; anything removed is pinned in git and re-pullable
# from the registry, so rollback is a re-pull, not a loss. Images (not
# volumes) only, and non-fatal: the deploy itself has already succeeded, and
# a failed prune costs disk, not availability.
docker image prune -af || true

# The deploy changed /opt/deploy's working tree (AIDE-monitored): acknowledge
# via the evidence-recording re-baseline, debounced so back-to-back deploys
# rebaseline once. Deploys are a trusted change channel (CI-gated, signed
# HEAD, announced via ntfy); tampering outside a deploy still alerts. Guarded:
# not every host runs the baseline-hardening AIDE stack.
if [[ "$old_head" != "$new_head" ]]; then
  systemctl restart aide-rebaseline-after-deploy.timer >/dev/null 2>&1 || true
fi

# A deploy only ships containers. When it moved the scaffold pointer, the
# host layer (roles, timers, scripts) is now behind until someone runs a site
# play -- say so once, here, and let scaffold-drift.timer keep nagging weekly.
# /var/lib/vps-site-applied is written by the site plays' post_tasks.
if [[ "$old_scaffold" != "$new_scaffold" ]]; then
  applied="$(cat /var/lib/vps-site-applied 2>/dev/null || echo none)"
  if [[ "$applied" != "$new_scaffold" ]]; then
    /usr/local/bin/vps-notify "Host play due: scaffold moved to ${new_scaffold:0:7}" \
"This deploy pulled scaffold ${old_scaffold:0:7} -> ${new_scaffold:0:7}; the last site play applied ${applied:0:7}.
Roles, timers and scripts only change on a play: run site-quick.yml (scaffold/docs/04-server-repo.md).
scaffold-drift.timer reminds weekly until they match." \
      default package || true
  fi
fi
