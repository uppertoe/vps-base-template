[Unit]
Description=Run Docker system prune weekly

[Timer]
# Run every Sunday at 03:00
OnCalendar=Sun *-*-* 03:00:00
# No Persistent=true on purpose: weekly housekeeping missed because the box was
# down can wait for next Sunday — it must NOT catch up on boot and add to the
# post-downtime timer storm on a 2 GB host. RandomizedDelaySec (up to 15 min)
# also keeps the normal run from colliding with the Sunday backup-verify.
RandomizedDelaySec=900

[Install]
WantedBy=timers.target
