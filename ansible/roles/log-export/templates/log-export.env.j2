# Managed by Ansible (log-export role). Secret — mode 0600, not in git.
# Credentials for the DEDICATED write-only IAM user (s3:PutObject only).
LOG_EXPORT_S3_URI={{ log_export_s3_uri }}
{% if log_export_aws_access_key_id | length > 0 %}
AWS_ACCESS_KEY_ID={{ log_export_aws_access_key_id }}
AWS_SECRET_ACCESS_KEY={{ log_export_aws_secret_access_key }}
{% endif %}
{% if log_export_aws_region | length > 0 %}
AWS_DEFAULT_REGION={{ log_export_aws_region }}
{% endif %}
