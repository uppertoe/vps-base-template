# log-export.service — Ship a hash-chained log archive off-host.
#
# Triggered by log-export.timer. Do not enable this unit directly.
# Installed by the log-export role.

[Unit]
Description=Off-host tamper-evident log export
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
Environment=STATE_DIR={{ log_export_state_dir }}
Environment=EXTRA_PATHS={{ log_export_extra_paths | join(':') }}
ExecStart=/usr/local/bin/log-export.sh
TimeoutStartSec=30m

# Resource guardrails (cgroup v2): archiving + compressing logs is CPU/disk
# bound, so yield both to the app tier (default weight 100) under contention and
# soft-cap memory. Keeps a boot-time catch-up from starving Caddy on the 2 GB host.
CPUWeight=20
IOWeight=20
MemoryHigh=256M

StandardOutput=journal
StandardError=journal
SyslogIdentifier=log-export

[Install]
WantedBy=multi-user.target
