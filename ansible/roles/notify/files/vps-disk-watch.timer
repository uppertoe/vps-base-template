# vps-disk-watch.timer — hourly disk-usage sweep. Installed by the notify role.

[Unit]
Description=Hourly disk usage watch
# NO Requires=<service> here: timers.target starts every timer at each boot, and
# Requires= would start the service along with it — running the job on EVERY
# boot (the actual boot-storm trigger). The Unit= line in [Timer] is the only
# service link a timer needs.

[Timer]
OnBootSec=10min
OnUnitActiveSec=1h
RandomizedDelaySec=5min
Unit=vps-disk-watch.service

[Install]
WantedBy=timers.target
