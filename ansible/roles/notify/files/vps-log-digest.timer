# vps-log-digest.timer — weekly digest schedule. Installed by the notify role.
#
# No Persistent=true on purpose: the weekly digest is informational, and a run
# missed because the box was down can wait for next Monday — it must NOT catch
# up on boot and add to the post-downtime timer storm on a 2 GB host.

[Unit]
Description=Weekly security digest
# NO Requires=<service> here: timers.target starts every timer at each boot, and
# Requires= would start the service along with it — running the job on EVERY
# boot (the actual boot-storm trigger). The Unit= line in [Timer] is the only
# service link a timer needs.

[Timer]
OnCalendar=Mon *-*-* 08:05:00
RandomizedDelaySec=900
Unit=vps-log-digest.service

[Install]
WantedBy=timers.target
