# Managed by Ansible (notify role). Secret — mode 0600, not in git.
NTFY_URL={{ notify_ntfy_url }}
{% if notify_ntfy_token | default('') | length > 0 %}
NTFY_TOKEN={{ notify_ntfy_token }}
{% endif %}
NOTIFY_DEFAULT_PRIORITY={{ notify_default_priority | default('high') }}
DEADMAN_URL={{ notify_deadman_url }}
{% if notify_deadman_token | default('') | length > 0 %}
DEADMAN_TOKEN={{ notify_deadman_token }}
{% endif %}
DISK_WATCH_WARN={{ notify_disk_watch_warn_pct }}
DISK_WATCH_CRIT={{ notify_disk_watch_crit_pct }}
CONTAINER_WATCH_GRACE_SECS={{ notify_container_watch_grace_secs }}
CONTAINER_WATCH_COOLDOWN_SECS={{ notify_container_watch_cooldown_secs }}
BOOT_CHECK_DEADLINE_SECS={{ notify_boot_check_deadline_secs }}
