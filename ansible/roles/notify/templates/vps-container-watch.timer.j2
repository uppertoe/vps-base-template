# vps-container-watch.timer — container health sweep schedule.
# Installed by the notify role.

[Unit]
Description=Container health watch (every {{ notify_container_watch_interval_min }} min)
# NO Requires=<service> here: timers.target starts every timer at each boot, and
# Requires= would start the service along with it — running the job on EVERY
# boot (the actual boot-storm trigger). The Unit= line in [Timer] is the only
# service link a timer needs.

[Timer]
OnBootSec=5min
OnUnitActiveSec={{ notify_container_watch_interval_min }}min
Unit=vps-container-watch.service

[Install]
WantedBy=timers.target
