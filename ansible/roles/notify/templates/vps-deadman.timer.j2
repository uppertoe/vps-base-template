# vps-deadman.timer — Heartbeat schedule for the external monitor.
#
# Installed by the notify role. Match the monitor's expected period + grace to
# {{ notify_deadman_interval_min }} minute(s).

[Unit]
Description=External dead-man's-switch heartbeat (every {{ notify_deadman_interval_min }} min)
# NO Requires=<service> here: timers.target starts every timer at each boot, and
# Requires= would start the service along with it — running the job on EVERY
# boot (the actual boot-storm trigger). The Unit= line in [Timer] is the only
# service link a timer needs.

[Timer]
OnBootSec=2min
OnUnitActiveSec={{ notify_deadman_interval_min }}min
Unit=vps-deadman.service

[Install]
WantedBy=timers.target
