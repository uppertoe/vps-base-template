# {{ ansible_managed }}
# vps-panic-guard-stable.timer — a host that has been up this long without
# incident has earned its automatic reboot back. notify_panic_guard_stable_min
# sets the wait; keep it comfortably longer than a boot takes to settle, or a
# crash loop re-arms itself.

[Unit]
Description=Re-arm kernel auto-reboot once the host has proved stable

[Timer]
OnBootSec={{ notify_panic_guard_stable_min | int }}min
AccuracySec=1min

[Install]
WantedBy=timers.target
