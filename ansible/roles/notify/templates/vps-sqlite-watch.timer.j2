# vps-sqlite-watch.timer — daily SQLite integrity sweep. Installed by the notify role.
#
# No Persistent=true: a sweep missed while the box was down waits for the next
# day rather than piling onto the post-boot timer storm on a 2 GB host.

[Unit]
Description=SQLite integrity watch — {{ notify_sqlite_watch_schedule }} schedule
# NO Requires=<service> here: timers.target starts every timer at each boot, and
# Requires= would start the service along with it — running the job on EVERY
# boot (the actual boot-storm trigger). The Unit= line in [Timer] is the only
# service link a timer needs.

[Timer]
OnCalendar={{ notify_sqlite_watch_schedule }}
RandomizedDelaySec=900
Unit=vps-sqlite-watch.service

[Install]
WantedBy=timers.target
