# vuln-scan.timer — Daily container image CVE scan.
#
# Daily scanning of internet-facing services is the Essential Eight ML1 /
# ISM cadence; the scan output starts the 48-hour patch clock for fixable
# critical vulnerabilities.
#
# Persistent=true keeps that daily CVE clock honest across reboots. This is the
# heaviest recurring job (Trivy pulls + scans every image), so RandomizedDelaySec
# smears its boot catch-up over 30 min — without it, a missed scan lands as a
# full Trivy run in the middle of the post-downtime boot storm on a 2 GB host.
#
# Installed by the vuln-scan Ansible role.

[Unit]
Description=Container image CVE scan — {{ vuln_scan_schedule }} schedule
# NO Requires=<service> here: timers.target starts every timer at each boot, and
# Requires= would start the service along with it — running the job on EVERY
# boot (the actual boot-storm trigger). The Unit= line in [Timer] is the only
# service link a timer needs.

[Timer]
OnCalendar={{ vuln_scan_schedule }}
Persistent=true
RandomizedDelaySec=1800
Unit=vuln-scan.service

[Install]
WantedBy=timers.target
