# sveltia-cms-auth — GitHub OAuth relay for Sveltia CMS.
# Copy to apps/cms-auth/.env and fill in. `./deploy` enforces mode 600.
# BASE_URL is set from ${DOMAIN} in docker-compose.yml (do not set it here).

# From the GitHub OAuth App (github.com → Settings → Developer settings →
# OAuth Apps → New OAuth App). The App's "Authorization callback URL" must be
# EXACTLY:  https://cms-auth.<DOMAIN>/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Comma-separated origins allowed to RECEIVE a token (the CMS admin pages that
# use this relay). A token is only ever postMessage'd to an origin listed here.
# Example: https://handbook.<DOMAIN>,https://<DOMAIN>
ALLOWED_ORIGINS=

# Optional. Stable HMAC key for the state cookie (else a random per-process key,
# fine for a single replica). Generate: openssl rand -hex 32
#STATE_SECRET=

# Optional scope controls (defaults shown). Use public_repo if the Hugo source
# repos are public.
#ALLOWED_SCOPES=repo,public_repo
#DEFAULT_SCOPE=repo
