{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "labels": [
    "dependencies"
  ],
  "docker": {
    "pinDigests": true
  },
  "docker-compose": {
    "managerFilePatterns": [
      "/(^|/)(?:docker-)?compose[^/]*\\.ya?ml$/",
      "/^docker/caddy\\.base\\.yml$/"
    ]
  },
  "github-actions": {
    "enabled": true
  },
  "customManagers": [
    {
      "customType": "regex",
      "description": "Digest-pinned images outside compose files: Ansible vars (Trivy scanner) and docker-run lines in workflows — keeps A6-class pins fresh",
      "managerFilePatterns": [
        "/^ansible/.+\\.ya?ml$/",
        "/^\\.github/workflows/.+\\.ya?ml$/"
      ],
      "matchStrings": [
        "(?<depName>[a-z0-9][a-z0-9._/-]*?):(?<currentValue>[a-zA-Z0-9][a-zA-Z0-9._-]*)@(?<currentDigest>sha256:[a-f0-9]{64})"
      ],
      "datasourceTemplate": "docker"
    }
  ],
  "packageRules": [
    {
      "description": "Regex-managed digest pins ride the same automerge+cooldown as compose pins",
      "matchManagers": [
        "custom.regex"
      ],
      "matchUpdateTypes": [
        "digest",
        "pin",
        "pinDigest"
      ],
      "groupName": "docker image digests",
      "minimumReleaseAge": "3 days",
      "automerge": true
    },
    {
      "description": "Group Docker image digest bumps so base-image CVE fixes flow through in one PR",
      "matchManagers": [
        "docker-compose",
        "dockerfile"
      ],
      "matchUpdateTypes": [
        "digest",
        "pin",
        "pinDigest"
      ],
      "groupName": "docker image digests",
      "minimumReleaseAge": "3 days",
      "automerge": true
    },
    {
      "description": "Automerge action pin/digest updates; version bumps stay manual",
      "matchManagers": [
        "github-actions"
      ],
      "matchUpdateTypes": [
        "digest",
        "pin",
        "pinDigest"
      ],
      "automerge": true
    }
  ]
}
