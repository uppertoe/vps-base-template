{
  // Renovate config for the scaffold repo. JSON5 (comments allowed), matching the
  // server-instance-template. This repo ships only THIRD-PARTY images (Trivy
  // scanner, Caddy base, GitHub Actions), so every update takes the 3-day cooldown
  // below — there are no first-party app images to exempt here. A repo that does
  // publish its own images adds a no-cooldown FIRST-PARTY rule (see the template's
  // renovate.json5 for the pattern).
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "labels": ["dependencies"],
  "docker": {
    "pinDigests": true,
  },
  "docker-compose": {
    "managerFilePatterns": [
      "/(^|/)(?:docker-)?compose[^/]*\\.ya?ml$/",
      "/^docker/caddy\\.base\\.yml$/",
    ],
  },
  "github-actions": {
    "enabled": true,
  },
  "customManagers": [
    {
      "customType": "regex",
      "description": "Digest-pinned images outside compose files: Ansible vars (Trivy scanner) and docker-run lines in workflows — keeps A6-class pins fresh",
      "managerFilePatterns": [
        "/^ansible/.+\\.ya?ml$/",
        "/^\\.github/workflows/.+\\.ya?ml$/",
      ],
      "matchStrings": [
        "(?<depName>[a-z0-9][a-z0-9._/-]*?):(?<currentValue>[a-zA-Z0-9][a-zA-Z0-9._-]*)@(?<currentDigest>sha256:[a-f0-9]{64})",
      ],
      "datasourceTemplate": "docker",
    },
  ],
  "packageRules": [
    {
      // NO minimumReleaseAge on digest rules: Renovate cannot date a Docker
      // digest ("digest update of <image> has no releaseTimestamp to age
      // against"), and with the default timestamp-required behaviour an undated
      // update stays pending forever — the old 3-day "cooldown" silently froze
      // the digest group (PR #75) from July 2026. A digest bump is a rebuild of
      // the same tag; CI remains the gate.
      "description": "Regex-managed digest pins ride the same automerge as compose pins",
      "matchManagers": ["custom.regex"],
      "matchUpdateTypes": ["digest", "pin", "pinDigest"],
      "groupName": "docker image digests",
      "automerge": true,
    },
    {
      "description": "Group Docker image digest bumps so base-image CVE fixes flow through in one PR",
      "matchManagers": ["docker-compose", "dockerfile"],
      "matchUpdateTypes": ["digest", "pin", "pinDigest"],
      "groupName": "docker image digests",
      "automerge": true,
    },
    {
      "description": "Automerge action pin/digest updates; version bumps stay manual",
      "matchManagers": ["github-actions"],
      "matchUpdateTypes": ["digest", "pin", "pinDigest"],
      "automerge": true,
    },
  ],
}
